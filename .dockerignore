.git/
.gitignore

# Environment files — never bake secrets into images
.env
.env.*
!.env.example

# IDE & OS
.vscode/
.idea/
.agents/
.claude/
.workflow/
.DS_Store

# Logs
*.log
logs/

# Test coverage
coverage/
.nyc_output/

# CI
.github/

# Docker files themselves
Dockerfile
docker-compose*.yml
deployment.yaml
probes/docker-compose.probe-test.yml
.dockerignore

# Docs
docs/
plans/
AGENTS.md
CLAUDE.md
README.md
CONTRIBUTING.md
SECURITY.md
CODE_OF_CONDUCT.md
LICENSE

# Temp
.temp/
.tmp/

