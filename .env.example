# APP Configuration
APP_NAME=
PORT=
NODE_ENV=
# Base URL of the web client, used for links inside emails (default: http://localhost:3000)
APP_WEB_URL=

# Database Configuration
DATABASE_URL=

# Initial SUPER_ADMIN bootstrap (used by pnpm admin:create)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Super Admin

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=beacon:

# JWT Configuration
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Throttler Configuration
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Uploadthing Configuration
UPLOADTHING_TOKEN=

# Resend Configuration
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# WeChat Configuration
# Pay V3 (set WECHAT_PAY_MOCK=true to keep billing runnable without credentials)
WECHAT_PAY_MCHID=
WECHAT_PAY_APPID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_APIV3_KEY=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_PUBLIC_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_MOCK=true
# Mini program
WECHAT_MINI_APPID=
WECHAT_MINI_APPSECRET=
# Official account / service account
WECHAT_OA_APPID=
WECHAT_OA_APPSECRET=
WECHAT_OA_TOKEN=
WECHAT_OA_AES_KEY=
# Enterprise WeChat (application)
WECHAT_WORK_CORPID=
WECHAT_WORK_CORPSECRET=
WECHAT_WORK_AGENTID=
# Shared HTTP client
WECHAT_HTTP_TIMEOUT_MS=8000
WECHAT_HTTP_MAX_RETRIES=2

# Logger Configuration
LOGGER_SERVICE_NAME=beacon
LOGGER_DIR=logs
LOGGER_LEVEL=info
LOGGER_PRETTY_PRINT=true
LOGGER_TO_CONSOLE=true
LOGGER_TO_FILE=false
LOGGER_EXCLUDE_PATHS=/api/docs,/health
LOGGER_SENSITIVE_FIELDS=password,token,refreshToken,accessToken,authorization,cookie,secret,secretKey,apiKey
