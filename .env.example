# APP Configuration
APP_NAME=beaconix
PORT=3000
HOST=localhost
NODE_ENV=development
# Base URL of the web client, used for links inside emails (default: http://localhost:3000)
APP_WEB_URL=http://localhost:5173

# NPM Registry
NPM_REGISTRY=https://registry.npmmirror.com

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/beaconix?schema=public&sslmode=disable
# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=beaconix

# Initial SUPER_ADMIN bootstrap (used by pnpm admin:create)
ADMIN_EMAIL=admin@beaconix.app
ADMIN_PASSWORD=Qwer1234
ADMIN_NAME=Super Admin

# Redis Configuration
REDIS_PORT=6376
REDIS_URL=redis://localhost:6376
REDIS_KEY_PREFIX=beaconix:
REDIS_PASSWORD=
REDIS_DB=0

# Application monitor credential encryption: independent 32-byte base64 key.
# Required only when saving/using monitor credentials. Keep identical on API/workers.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MONITOR_SECRET_KEY=
# Local Docker monitoring is OFF unless BOTH socket and tenant allowlist are set.
# Mount only a read-only Docker API proxy where possible; never expose an unauthenticated daemon.
MONITOR_DOCKER_SOCKET_PATH=
MONITOR_DOCKER_SOCKET_ORGANIZATION_IDS=

# Probe Configuration
# A probe that stays silent for this long is marked offline; probes reporting
# their own heartbeat interval get three intervals when that is longer.
PROBE_OFFLINE_AFTER_SECONDS=180

# Scheduler Configuration
# Timezone the recurring-job cron patterns are evaluated in (IANA name, for
# example Asia/Shanghai). Empty keeps the process timezone.
SCHEDULER_TIMEZONE=

# JWT Configuration
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Throttler Configuration
THROTTLE_TTL=60
THROTTLE_LIMIT=10
THROTTLE_DEVELOPER_TTL=60
THROTTLE_DEVELOPER_LIMIT=60

# Two-Factor Authentication (TOTP)
# 32-byte base64 key used to encrypt TOTP secrets. Required: the app refuses to
# start without it (do not fall back to plaintext). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TWO_FACTOR_SECRET_KEY=
TWO_FACTOR_ISSUER=Beaconix
TWO_FACTOR_CHALLENGE_TTL_SECONDS=300
TWO_FACTOR_SETUP_TTL_SECONDS=600
TWO_FACTOR_MAX_ATTEMPTS=5
TWO_FACTOR_RECOVERY_CODE_COUNT=10

# Attachment Storage Bootstrap / Secrets
# Public attachments (avatars, brand images, general uploads) live here and may
# be served statically: storage/public/{avatars,uploads}/yyyy/mm/…
# `STORAGE_LOCAL_ROOT` is accepted as a fallback for deployments that still use
# the pre-split name.
STORAGE_PUBLIC_ROOT=storage/public
# Private attachments (task files, ticket files) must be outside the public
# storage directory and web roots: storage/private/{attachments,tickets}/…
STORAGE_PRIVATE_ROOT=storage/private

# oss configuration
# These variables are fallbacks only: the active values come from the
# `storage.oss.*` platform settings (admin UI). A non-empty setting row wins.
STORAGE_OSS_ENDPOINT=
STORAGE_OSS_REGION=auto
STORAGE_OSS_BUCKET=
# Separate private bucket; deny anonymous reads in bucket policy and CDN settings.
STORAGE_OSS_PRIVATE_BUCKET=
STORAGE_OSS_ACCESS_KEY_ID=
STORAGE_OSS_ACCESS_KEY_SECRET=
STORAGE_OSS_FORCE_PATH_STYLE=false

# Resend Configuration
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# WeChat Configuration
# Every key below can be overridden at runtime from the admin settings page
# (Admin / Settings → wechat tab). A value saved there wins; an empty value or
# a key never touched in the UI falls back to the environment variable here,
# so existing .env deployments keep working unchanged.
# Pay V3 (set WECHAT_PAY_MOCK=true to keep billing runnable without credentials)
WECHAT_PAY_MCHID=
WECHAT_PAY_APPID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_APIV3_KEY=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_PUBLIC_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_MOCK=true
# Mini-program virtual payment (virtual goods: subscriptions / feature unlocks).
# Credentials come from MP console → 虚拟支付 → 基本配置. Keep WECHAT_VIRTUALPAY_ENV=0
# in production (env=1 is sandbox and WeChat rejects it on a production build).
# Each PlanTerm must map to a published product id (道具 ID) with the same price.
WECHAT_VIRTUALPAY_OFFER_ID=
WECHAT_VIRTUALPAY_APP_KEY=
WECHAT_VIRTUALPAY_SANDBOX_APP_KEY=
WECHAT_VIRTUALPAY_ENV=0
# Token configured under MP console → 开发管理 → 消息推送 (plaintext signature check)
WECHAT_VIRTUALPAY_PUSH_TOKEN=
WECHAT_VIRTUALPAY_PUSH_AES_KEY=
WECHAT_VIRTUALPAY_MOCK=true
# Mini program
WECHAT_MINI_APPID=
WECHAT_MINI_APPSECRET=
# Open Platform website app (web QR login, snsapi_login)
WECHAT_WEB_APPID=
WECHAT_WEB_APPSECRET=
# Mini-program scan login (unlimited QR code)
WECHAT_SCAN_LOGIN_PAGE=
# release | trial | develop
WECHAT_SCAN_LOGIN_ENV_VERSION=release
WECHAT_SCAN_LOGIN_TTL_SECONDS=300
WECHAT_SCAN_LOGIN_POLL_TIMEOUT_MS=25000
# Official account / service account
WECHAT_OA_APPID=
WECHAT_OA_APPSECRET=
WECHAT_OA_TOKEN=
WECHAT_OA_AES_KEY=
# Enterprise WeChat (application)
WECHAT_WORK_CORPID=
WECHAT_WORK_CORPSECRET=
WECHAT_WORK_AGENTID=
# Shared HTTP client
WECHAT_HTTP_TIMEOUT_MS=8000
WECHAT_HTTP_MAX_RETRIES=2

# Alipay Configuration
# Same merge rule as WeChat: Admin / Settings → alipay wins, an empty value or a
# key never touched in the UI falls back to the environment variables below.
# ALIPAY_MOCK=true keeps the billing flow runnable without any credentials;
# turn it off before accepting real payments.
ALIPAY_APPID=
# App private key — paste the PEM block or point at a file on the server.
# Alipay's key tool emits PKCS8; the client detects PKCS1 by its PEM header.
ALIPAY_PRIVATE_KEY=
# Alipay public key (NOT the app public key) — PEM block or file path.
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# RSA2 | RSA (RSA2 for every new app)
ALIPAY_SIGN_TYPE=RSA2
# true = sandbox gateway (still calls Alipay for real), independent of ALIPAY_MOCK
ALIPAY_SANDBOX=false
# Public URL Alipay posts async notifications to (/api/payment/alipay/callback)
ALIPAY_NOTIFY_URL=
# Browser redirect after payment (result page) — cosmetics only, never proof of payment
ALIPAY_RETURN_URL=
ALIPAY_MOCK=true

# Logger Configuration
LOGGER_SERVICE_NAME=beaconix
LOGGER_DIR=logs
LOGGER_LEVEL=info
LOGGER_PRETTY_PRINT=true
LOGGER_TO_CONSOLE=true
LOGGER_TO_FILE=false
LOGGER_EXCLUDE_PATHS=/api/docs,/health,/metrics
LOGGER_SENSITIVE_FIELDS=password,token,refreshToken,accessToken,authorization,cookie,secret,secretKey,apiKey
