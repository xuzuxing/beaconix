<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{{ title }}</title>
        <style>
            :root {
                color-scheme: light;
                --bg: #f5f7fa;
                --panel: #ffffff;
                --panel-soft: #f9fafb;
                --line: #d8e0ea;
                --line-strong: #bcc7d6;
                --ink: #132033;
                --muted: #64748b;
                --brand: #2563eb;
                --brand-dark: #1d4ed8;
                --ok: #087f5b;
                --bad: #b42318;
                --warn: #a16207;
                --code: #0f172a;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background: var(--bg);
                color: var(--ink);
                font-family:
                    Inter, ui-sans-serif, system-ui, -apple-system,
                    BlinkMacSystemFont, "Segoe UI", sans-serif;
            }

            header {
                border-bottom: 1px solid var(--line);
                background: var(--panel);
            }

            .shell {
                width: min(1240px, calc(100vw - 32px));
                margin: 0 auto;
            }

            .topbar {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                min-height: 68px;
            }

            h1,
            h2,
            h3 {
                margin: 0;
                letter-spacing: 0;
            }

            h1 {
                font-size: 22px;
                line-height: 1.25;
            }

            h2 {
                font-size: 15px;
                line-height: 1.3;
            }

            h3 {
                font-size: 13px;
                line-height: 1.3;
                color: var(--muted);
                text-transform: uppercase;
            }

            main {
                display: grid;
                grid-template-columns: 390px 1fr;
                gap: 18px;
                align-items: start;
                padding: 22px 0 40px;
            }

            section {
                border: 1px solid var(--line);
                border-radius: 8px;
                background: var(--panel);
                padding: 16px;
            }

            .stack {
                display: grid;
                gap: 14px;
            }

            .panel-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 18px;
            }

            .group {
                display: grid;
                gap: 12px;
                border-top: 1px solid var(--line);
                padding-top: 14px;
            }

            .group:first-of-type {
                border-top: 0;
                padding-top: 0;
            }

            label {
                display: grid;
                gap: 6px;
                min-width: 0;
                font-size: 13px;
                font-weight: 650;
            }

            input,
            select,
            textarea {
                width: 100%;
                min-width: 0;
                border: 1px solid var(--line);
                border-radius: 6px;
                padding: 10px 11px;
                color: var(--ink);
                background: #fff;
                font: inherit;
                font-size: 14px;
            }

            textarea {
                min-height: 96px;
                resize: vertical;
                font-family:
                    ui-monospace, SFMono-Regular, Menlo, Consolas,
                    "Liberation Mono", monospace;
            }

            input:focus,
            select:focus,
            textarea:focus {
                border-color: var(--brand);
                outline: 3px solid #dbeafe;
            }

            .row {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
            }

            .actions {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 10px;
            }

            .auth-actions {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }

            .wide-actions {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }

            button {
                min-height: 38px;
                border: 1px solid transparent;
                border-radius: 6px;
                padding: 9px 12px;
                color: #fff;
                background: var(--brand);
                cursor: pointer;
                font: inherit;
                font-size: 14px;
                font-weight: 700;
                line-height: 1.2;
            }

            button.secondary {
                border-color: var(--line-strong);
                color: var(--ink);
                background: #fff;
            }

            button.danger {
                background: var(--bad);
            }

            button:hover {
                background: var(--brand-dark);
            }

            button.secondary:hover {
                background: #eef4ff;
            }

            button.danger:hover {
                background: #8f1f15;
            }

            button:disabled {
                cursor: wait;
                opacity: 0.65;
            }

            .subtitle,
            .meta,
            .hint {
                color: var(--muted);
                font-size: 13px;
                line-height: 1.5;
            }

            .status {
                display: inline-flex;
                align-items: center;
                min-height: 28px;
                border-radius: 999px;
                padding: 4px 10px;
                background: #eef4ff;
                color: var(--brand-dark);
                font-size: 13px;
                font-weight: 700;
                white-space: nowrap;
            }

            .status.ok {
                background: #e8f8f1;
                color: var(--ok);
            }

            .status.bad {
                background: #fff0ed;
                color: var(--bad);
            }

            .status.warn {
                background: #fef8e7;
                color: var(--warn);
            }

            .request-line {
                display: flex;
                align-items: center;
                gap: 8px;
                min-height: 32px;
                min-width: 0;
                border: 1px solid var(--line);
                border-radius: 6px;
                background: var(--panel-soft);
                padding: 6px 8px;
                color: var(--muted);
                font-family:
                    ui-monospace, SFMono-Regular, Menlo, Consolas,
                    "Liberation Mono", monospace;
                font-size: 12px;
            }

            .method {
                flex: 0 0 auto;
                color: var(--ink);
                font-weight: 800;
            }

            .path {
                min-width: 0;
                overflow-wrap: anywhere;
            }

            pre {
                min-height: 460px;
                max-height: 680px;
                overflow: auto;
                margin: 0;
                border-radius: 8px;
                padding: 16px;
                background: var(--code);
                color: #d9e7ff;
                font-size: 13px;
                line-height: 1.55;
                white-space: pre-wrap;
                word-break: break-word;
            }

            .toolbar {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
            }

            .toolbar-actions {
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
                justify-content: flex-end;
            }

            .full {
                grid-column: 1 / -1;
            }

            @media (max-width: 980px) {
                main,
                .panel-grid,
                .row {
                    grid-template-columns: 1fr;
                }

                .topbar {
                    align-items: flex-start;
                    flex-direction: column;
                    padding: 16px 0;
                }
            }

            @media (max-width: 560px) {
                .shell {
                    width: min(100vw - 20px, 1240px);
                }

                .actions,
                .toolbar {
                    grid-template-columns: 1fr;
                }

                .toolbar {
                    align-items: stretch;
                    flex-direction: column;
                }

                .toolbar-actions {
                    justify-content: stretch;
                }

                .toolbar-actions button,
                .actions button {
                    width: 100%;
                }
            }
        </style>
    </head>
    <body>
        <header>
            <div class="shell topbar">
                <div>
                    <h1>{{ title }}</h1>
                    <div class="subtitle">Rendered at {{ renderedAt }}</div>
                </div>
                <span id="status" class="status">Ready</span>
            </div>
        </header>

        <main class="shell">
            <section class="stack">
                <div class="toolbar">
                    <h2>Context</h2>
                    <button data-action="health" class="secondary">
                        Health
                    </button>
                </div>

                <label>
                    API Base
                    <input id="apiBase" value="{{ apiBase }}" />
                </label>

                <div class="row">
                    <label>
                        Name
                        <input
                            id="name"
                            autocomplete="name"
                            placeholder="John Doe"
                            maxlength="100"
                        />
                    </label>
                    <label>
                        Email
                        <input
                            id="email"
                            type="email"
                            autocomplete="username"
                            placeholder="admin@example.com"
                        />
                    </label>
                </div>

                <div class="row">
                    <label>
                        Password
                        <input
                            id="password"
                            type="password"
                            autocomplete="current-password"
                            placeholder="password"
                        />
                    </label>
                    <label>
                        OTP Code
                        <input
                            id="otpCode"
                            inputmode="numeric"
                            maxlength="6"
                            placeholder="123456"
                        />
                    </label>
                </div>

                <label>
                    New Password
                    <input
                        id="newPassword"
                        type="password"
                        autocomplete="new-password"
                        placeholder="new password"
                    />
                </label>

                <div class="actions auth-actions">
                    <button data-action="register" class="secondary">
                        Register
                    </button>
                    <button data-action="verifyEmail" class="secondary">
                        Verify Email
                    </button>
                    <button data-action="resendVerification" class="secondary">
                        Resend OTP
                    </button>
                    <button data-action="login">Login</button>
                    <button data-action="refresh" class="secondary">Refresh</button>
                    <button data-action="me" class="secondary">Me</button>
                    <button data-action="forgotPassword" class="secondary">
                        Forgot Password
                    </button>
                    <button data-action="resetPassword" class="secondary">
                        Reset Password
                    </button>
                    <button data-action="logout" class="danger">Logout</button>
                </div>

                <label>
                    Access Token
                    <textarea
                        id="token"
                        placeholder="Paste JWT access token here"
                    ></textarea>
                </label>

                <label>
                    Refresh Token
                    <textarea
                        id="refreshToken"
                        placeholder="Login or verify email to fill refresh token"
                    ></textarea>
                </label>

                <div class="row">
                    <label>
                        Organization ID
                        <input id="orgId" placeholder="org uuid" />
                    </label>
                    <label>
                        Active Organization
                        <select id="orgSelect">
                            <option value="">Manual organization ID</option>
                        </select>
                    </label>
                </div>

                <label>
                    Project ID
                    <input id="projectId" placeholder="project uuid" />
                </label>
            </section>

            <div class="panel-grid">
                <section class="stack">
                    <div class="group">
                        <div>
                            <h2>Organization Actions</h2>
                            <div class="meta">/organizations</div>
                        </div>

                        <div class="row">
                            <label>
                                Organization Name
                                <input
                                    id="orgName"
                                    value="Beacon Team"
                                    maxlength="100"
                                />
                            </label>
                            <label>
                                Slug
                                <input
                                    id="orgSlug"
                                    value="beacon-team"
                                    maxlength="50"
                                    pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
                                />
                            </label>
                        </div>

                        <label>
                            Organization Description
                            <input
                                id="orgDescription"
                                value="Workspace for Beacon examples"
                                maxlength="500"
                            />
                        </label>

                        <div class="actions wide-actions">
                            <button data-action="listOrganizations" class="secondary">
                                List Organizations
                            </button>
                            <button data-action="createOrganization">
                                Create Organization
                            </button>
                            <button data-action="getOrganization" class="secondary">
                                Get Organization
                            </button>
                            <button data-action="updateOrganization" class="secondary">
                                Update Organization
                            </button>
                            <button data-action="deleteOrganization" class="danger">
                                Delete Organization
                            </button>
                        </div>
                    </div>
                </section>

                <section class="stack">
                    <div class="group">
                        <div>
                            <h2>Project Actions</h2>
                            <div class="meta">/organizations/:orgId/projects</div>
                        </div>

                        <div class="row">
                            <label>
                                Project Name
                                <input
                                    id="projectName"
                                    value="Beacon Demo"
                                    maxlength="100"
                                />
                            </label>
                            <label>
                                Project Key
                                <input
                                    id="projectKey"
                                    value="DEMO"
                                    maxlength="10"
                                    pattern="[A-Z0-9]{2,10}"
                                />
                            </label>
                        </div>

                        <label>
                            Project Description
                            <input
                                id="projectDescription"
                                value="Monitor testing workspace"
                                maxlength="500"
                            />
                        </label>

                        <div class="actions">
                            <button data-action="listProjects" class="secondary">
                                List Projects
                            </button>
                            <button data-action="createProject">
                                Create Project
                            </button>
                            <button data-action="getProject" class="secondary">
                                Get Project
                            </button>
                            <button data-action="archiveProject" class="secondary">
                                Archive Project
                            </button>
                            <button data-action="restoreProject" class="secondary">
                                Restore Project
                            </button>
                            <button data-action="deleteProject" class="danger">
                                Delete Project
                            </button>
                        </div>
                    </div>
                </section>

                <section class="stack">
                    <div class="group">
                        <div>
                            <h2>Monitor Actions</h2>
                            <div class="meta">/projects/:projectId/monitors</div>
                        </div>

                        <label>
                            Monitor ID
                            <input id="monitorId" placeholder="monitor uuid" />
                        </label>

                        <label>
                            Monitor Name
                            <input
                                id="monitorName"
                                value="Demo monitor"
                                maxlength="100"
                            />
                        </label>

                        <div class="row">
                            <label>
                                Type
                                <select id="monitorType">
                                    <option value="HTTP">HTTP</option>
                                    <option value="TCP">TCP</option>
                                </select>
                            </label>
                            <label>
                                Expected HTTP Status
                                <input
                                    id="expectedStatus"
                                    type="number"
                                    min="100"
                                    max="599"
                                    value="200"
                                />
                            </label>
                        </div>

                        <label>
                            Target
                            <input
                                id="target"
                                value="https://example.com"
                                placeholder="https://example.com/health or host:port"
                            />
                        </label>

                        <div class="row">
                            <label>
                                Interval Seconds
                                <input
                                    id="interval"
                                    type="number"
                                    min="10"
                                    max="86400"
                                    value="60"
                                />
                            </label>
                            <label>
                                Timeout Milliseconds
                                <input
                                    id="timeout"
                                    type="number"
                                    min="100"
                                    max="60000"
                                    value="5000"
                                />
                            </label>
                        </div>

                        <div class="row">
                            <label>
                                Failure Threshold
                                <input
                                    id="failureThreshold"
                                    type="number"
                                    min="1"
                                    max="10"
                                    value="3"
                                />
                            </label>
                            <label>
                                Enabled
                                <select id="enabled">
                                    <option value="true">true</option>
                                    <option value="false">false</option>
                                </select>
                            </label>
                        </div>

                        <div class="actions">
                            <button data-action="listMonitors" class="secondary">
                                List Monitors
                            </button>
                            <button data-action="createMonitor">
                                Create Monitor
                            </button>
                            <button data-action="getMonitor" class="secondary">
                                Get Monitor
                            </button>
                            <button data-action="updateMonitor" class="secondary">
                                Update Monitor
                            </button>
                            <button data-action="pauseMonitor" class="secondary">
                                Pause
                            </button>
                            <button data-action="resumeMonitor" class="secondary">
                                Resume
                            </button>
                            <button data-action="runCheck">Run Check</button>
                            <button data-action="getState" class="secondary">
                                State
                            </button>
                            <button data-action="listChecks" class="secondary">
                                Check Logs
                            </button>
                            <button data-action="restoreMonitor" class="secondary">
                                Restore
                            </button>
                            <button data-action="deleteMonitor" class="danger">
                                Delete
                            </button>
                        </div>
                    </div>
                </section>
            </div>

            <section class="stack full">
                <div class="toolbar">
                    <div>
                        <h2>Response</h2>
                        <div id="requestLine" class="request-line">
                            <span class="method">-</span>
                            <span class="path">No request sent yet.</span>
                        </div>
                    </div>
                    <div class="toolbar-actions">
                        <button id="copyOutput" class="secondary">Copy</button>
                        <button id="clearCache" class="secondary">
                            Clear Cache
                        </button>
                        <button id="clearOutput" class="secondary">Clear</button>
                    </div>
                </div>
                <pre id="output">No request sent yet.</pre>
            </section>
        </main>

        <script>
            const $ = (id) => document.getElementById(id);
            const statusEl = $("status");
            const outputEl = $("output");
            const requestLineEl = $("requestLine");
            const orgSelectEl = $("orgSelect");
            const cacheKey = "beacon.monitorTest.v1";
            const cacheFieldIds = [
                "apiBase",
                "name",
                "email",
                "password",
                "otpCode",
                "newPassword",
                "token",
                "refreshToken",
                "orgId",
                "projectId",
                "monitorId",
                "orgName",
                "orgSlug",
                "orgDescription",
                "projectName",
                "projectKey",
                "projectDescription",
                "monitorName",
                "monitorType",
                "expectedStatus",
                "target",
                "interval",
                "timeout",
                "failureThreshold",
                "enabled",
            ];

            function setStatus(text, kind) {
                statusEl.textContent = text;
                statusEl.className = "status" + (kind ? " " + kind : "");
            }

            function setRequestLine(method, path) {
                requestLineEl.querySelector(".method").textContent = method;
                requestLineEl.querySelector(".path").textContent = path;
            }

            function cacheSnapshot() {
                return cacheFieldIds.reduce((result, id) => {
                    const field = $(id);
                    if (field) result[id] = field.value;
                    return result;
                }, {});
            }

            function saveCache() {
                localStorage.setItem(cacheKey, JSON.stringify(cacheSnapshot()));
            }

            function restoreCache() {
                const raw = localStorage.getItem(cacheKey);
                if (!raw) return;

                let cached;
                try {
                    cached = JSON.parse(raw);
                } catch {
                    localStorage.removeItem(cacheKey);
                    return;
                }

                cacheFieldIds.forEach((id) => {
                    const field = $(id);
                    if (field && typeof cached[id] === "string") {
                        field.value = cached[id];
                    }
                });
            }

            function apiBase() {
                return $("apiBase").value.replace(/\/$/, "");
            }

            function token() {
                return $("token").value.trim();
            }

            function refreshToken() {
                return $("refreshToken").value.trim();
            }

            function email() {
                return $("email").value.trim();
            }

            function orgId() {
                return $("orgId").value.trim();
            }

            function projectId() {
                return $("projectId").value.trim();
            }

            function monitorId() {
                return $("monitorId").value.trim();
            }

            function headers(hasBody) {
                const result = {};
                if (hasBody) result["content-type"] = "application/json";
                if (token()) result.authorization = "Bearer " + token();
                return result;
            }

            function requireValue(value, label) {
                if (!value) throw new Error(label + " is required");
                return value;
            }

            function numberValue(id) {
                const value = Number($(id).value);
                return Number.isFinite(value) ? value : undefined;
            }

            function responsePayload(body) {
                if (!body || typeof body !== "object") return body;
                return body.data || body;
            }

            function firstItem(value) {
                if (Array.isArray(value)) return value[0];
                if (value && Array.isArray(value.items)) return value.items[0];
                if (value && Array.isArray(value.data)) return value.data[0];
                return value;
            }

            function asList(value) {
                const payload = responsePayload(value);
                if (Array.isArray(payload)) return payload;
                if (payload && Array.isArray(payload.items)) return payload.items;
                if (payload && Array.isArray(payload.data)) return payload.data;
                return [];
            }

            function orgLabel(org) {
                return [org.name, org.slug].filter(Boolean).join(" / ") || org.id;
            }

            function isOrganizationEntity(item) {
                return Boolean(item && item.id && typeof item.slug === "string");
            }

            function isMonitorEntity(item) {
                return Boolean(
                    item &&
                        item.id &&
                        ("target" in item ||
                            "expectedStatus" in item ||
                            "failureThreshold" in item),
                );
            }

            function isProjectEntity(item) {
                return Boolean(
                    item &&
                        item.id &&
                        "key" in item &&
                        "organizationId" in item &&
                        !isMonitorEntity(item),
                );
            }

            function upsertOrganizationOption(org) {
                if (!isOrganizationEntity(org)) return;

                let option = orgSelectEl.querySelector(
                    'option[value="' + org.id + '"]',
                );
                if (!option) {
                    option = document.createElement("option");
                    option.value = org.id;
                    orgSelectEl.appendChild(option);
                }
                option.textContent = orgLabel(org);
            }

            function renderOrganizations(body) {
                const organizations = asList(body).filter(
                    (item) => item && typeof item === "object" && isOrganizationEntity(item),
                );
                if (!organizations.length) return;

                orgSelectEl.innerHTML =
                    '<option value="">Manual organization ID</option>';
                organizations.forEach((org) => {
                    upsertOrganizationOption(org);
                });

                const activeOrgId = orgId() || organizations[0].id;
                $("orgId").value = activeOrgId;
                orgSelectEl.value = activeOrgId;
            }

            function syncIds(body) {
                const payload = responsePayload(body);
                const item = firstItem(payload);
                if (!item || typeof item !== "object") return;

                if (item.accessToken) $("token").value = item.accessToken;
                if (item.refreshToken) $("refreshToken").value = item.refreshToken;
                if (isOrganizationEntity(item)) {
                    const previousOrgId = orgId();
                    upsertOrganizationOption(item);
                    $("orgId").value = item.id;
                    orgSelectEl.value = item.id;
                    if (previousOrgId && previousOrgId !== item.id) {
                        $("projectId").value = "";
                        $("monitorId").value = "";
                    }
                }
                if (item.projectId && !$("projectId").value) {
                    $("projectId").value = item.projectId;
                }
                if (item.monitorId && !$("monitorId").value) {
                    $("monitorId").value = item.monitorId;
                }
                if (item.id) {
                    if (isProjectEntity(item)) {
                        $("projectId").value = item.id;
                    }
                    if (isMonitorEntity(item)) {
                        $("monitorId").value = item.id;
                    }
                }
                saveCache();
            }

            async function request(path, options = {}) {
                const method = options.method || "GET";
                const hasBody = typeof options.body !== "undefined";
                setStatus("Loading", "warn");
                setRequestLine(method, path || "/");

                const response = await fetch(apiBase() + path, {
                    ...options,
                    headers: {
                        ...headers(hasBody),
                        ...(options.headers || {}),
                    },
                });

                const text = await response.text();
                let body = text;
                try {
                    body = text ? JSON.parse(text) : null;
                } catch {
                    body = text;
                }

                syncIds(body);
                renderOrganizations(body);
                saveCache();
                outputEl.textContent = JSON.stringify(
                    {
                        status: response.status,
                        ok: response.ok,
                        body,
                    },
                    null,
                    2,
                );
                setStatus(response.ok ? "OK" : "Failed", response.ok ? "ok" : "bad");
                return { ok: response.ok, status: response.status, body };
            }

            function projectPath(suffix = "") {
                return (
                    "/organizations/" +
                    requireValue(orgId(), "Organization ID") +
                    "/projects" +
                    suffix
                );
            }

            function monitorPath(suffix = "") {
                return (
                    "/projects/" +
                    requireValue(projectId(), "Project ID") +
                    "/monitors" +
                    suffix
                );
            }

            function organizationBody() {
                return {
                    name: requireValue(
                        $("orgName").value.trim(),
                        "Organization Name",
                    ),
                    slug: requireValue(
                        $("orgSlug").value.trim().toLowerCase(),
                        "Slug",
                    ),
                    description: $("orgDescription").value.trim(),
                };
            }

            function monitorBody() {
                return {
                    name: $("monitorName").value.trim(),
                    type: $("monitorType").value,
                    target: $("target").value.trim(),
                    interval: numberValue("interval"),
                    timeout: numberValue("timeout"),
                    expectedStatus: numberValue("expectedStatus"),
                    failureThreshold: numberValue("failureThreshold"),
                    enabled: $("enabled").value === "true",
                };
            }

            const actions = {
                health: () => request("", { method: "GET" }),
                register: () =>
                    request("/auth/register", {
                        method: "POST",
                        body: JSON.stringify({
                            name: requireValue($("name").value.trim(), "Name"),
                            email: requireValue(email(), "Email"),
                            password: requireValue(
                                $("password").value,
                                "Password",
                            ),
                        }),
                    }),
                verifyEmail: () =>
                    request("/auth/verify-email", {
                        method: "POST",
                        body: JSON.stringify({
                            email: requireValue(email(), "Email"),
                            code: requireValue($("otpCode").value.trim(), "OTP Code"),
                        }),
                    }),
                resendVerification: () =>
                    request("/auth/resend-verification", {
                        method: "POST",
                        body: JSON.stringify({
                            email: requireValue(email(), "Email"),
                        }),
                    }),
                login: () =>
                    request("/auth/login", {
                        method: "POST",
                        body: JSON.stringify({
                            email: requireValue(email(), "Email"),
                            password: requireValue(
                                $("password").value,
                                "Password",
                            ),
                        }),
                    }),
                refresh: () =>
                    request("/auth/refresh", {
                        method: "POST",
                        body: JSON.stringify({
                            refreshToken: requireValue(
                                refreshToken(),
                                "Refresh Token",
                            ),
                        }),
                    }),
                forgotPassword: () =>
                    request("/auth/forgot-password", {
                        method: "POST",
                        body: JSON.stringify({
                            email: requireValue(email(), "Email"),
                        }),
                    }),
                resetPassword: () =>
                    request("/auth/reset-password", {
                        method: "POST",
                        body: JSON.stringify({
                            email: requireValue(email(), "Email"),
                            code: requireValue($("otpCode").value.trim(), "OTP Code"),
                            newPassword: requireValue(
                                $("newPassword").value,
                                "New Password",
                            ),
                        }),
                    }),
                logout: async () => {
                    const result = await request("/auth/logout", {
                        method: "POST",
                        body: JSON.stringify({
                            refreshToken: requireValue(
                                refreshToken(),
                                "Refresh Token",
                            ),
                        }),
                    });
                    if (result.ok) {
                        $("token").value = "";
                        $("refreshToken").value = "";
                        saveCache();
                        setStatus("Logged out", "ok");
                    }
                },
                me: () => request("/auth/me", { method: "GET" }),
                listOrganizations: () =>
                    request("/organizations", { method: "GET" }),
                createOrganization: () =>
                    request("/organizations", {
                        method: "POST",
                        body: JSON.stringify(organizationBody()),
                    }),
                getOrganization: () =>
                    request(
                        "/organizations/" +
                            requireValue(orgId(), "Organization ID"),
                        { method: "GET" },
                    ),
                updateOrganization: () =>
                    request(
                        "/organizations/" +
                            requireValue(orgId(), "Organization ID"),
                        {
                            method: "PATCH",
                            body: JSON.stringify(organizationBody()),
                        },
                    ),
                deleteOrganization: () =>
                    request(
                        "/organizations/" +
                            requireValue(orgId(), "Organization ID"),
                        { method: "DELETE" },
                    ),
                listProjects: () => request(projectPath(), { method: "GET" }),
                createProject: () =>
                    request(projectPath(), {
                        method: "POST",
                        body: JSON.stringify({
                            name: requireValue(
                                $("projectName").value.trim(),
                                "Project Name",
                            ),
                            key: requireValue(
                                $("projectKey").value.trim().toUpperCase(),
                                "Project Key",
                            ),
                            description: $("projectDescription").value.trim(),
                        }),
                    }),
                getProject: () =>
                    request(
                        projectPath("/" + requireValue(projectId(), "Project ID")),
                        { method: "GET" },
                    ),
                archiveProject: () =>
                    request(
                        projectPath(
                            "/" + requireValue(projectId(), "Project ID") + "/archive",
                        ),
                        { method: "POST" },
                    ),
                restoreProject: () =>
                    request(
                        projectPath(
                            "/" + requireValue(projectId(), "Project ID") + "/restore",
                        ),
                        { method: "POST" },
                    ),
                deleteProject: () =>
                    request(
                        projectPath("/" + requireValue(projectId(), "Project ID")),
                        { method: "DELETE" },
                    ),
                listMonitors: () => request(monitorPath(), { method: "GET" }),
                createMonitor: () =>
                    request(monitorPath(), {
                        method: "POST",
                        body: JSON.stringify(monitorBody()),
                    }),
                getMonitor: () =>
                    request(
                        monitorPath("/" + requireValue(monitorId(), "Monitor ID")),
                        { method: "GET" },
                    ),
                updateMonitor: () =>
                    request(
                        monitorPath("/" + requireValue(monitorId(), "Monitor ID")),
                        {
                            method: "PATCH",
                            body: JSON.stringify(monitorBody()),
                        },
                    ),
                pauseMonitor: () =>
                    request(
                        monitorPath(
                            "/" + requireValue(monitorId(), "Monitor ID") + "/pause",
                        ),
                        { method: "POST" },
                    ),
                resumeMonitor: () =>
                    request(
                        monitorPath(
                            "/" + requireValue(monitorId(), "Monitor ID") + "/resume",
                        ),
                        { method: "POST" },
                    ),
                deleteMonitor: () =>
                    request(
                        monitorPath("/" + requireValue(monitorId(), "Monitor ID")),
                        { method: "DELETE" },
                    ),
                restoreMonitor: () =>
                    request(
                        monitorPath(
                            "/" + requireValue(monitorId(), "Monitor ID") + "/restore",
                        ),
                        { method: "POST" },
                    ),
                runCheck: () =>
                    request(
                        monitorPath(
                            "/" + requireValue(monitorId(), "Monitor ID") + "/check",
                        ),
                        { method: "POST" },
                    ),
                getState: () =>
                    request(
                        monitorPath(
                            "/" + requireValue(monitorId(), "Monitor ID") + "/state",
                        ),
                        { method: "GET" },
                    ),
                listChecks: () =>
                    request(
                        monitorPath(
                            "/" + requireValue(monitorId(), "Monitor ID") + "/checks",
                        ),
                        { method: "GET" },
                    ),
            };

            document.addEventListener("click", async (event) => {
                const button = event.target.closest("[data-action]");
                if (!button) return;

                const action = actions[button.dataset.action];
                if (!action) return;

                const buttons = Array.from(document.querySelectorAll("button"));
                try {
                    buttons.forEach((item) => {
                        item.disabled = true;
                    });
                    await action();
                } catch (error) {
                    setStatus("Error", "bad");
                    outputEl.textContent = error.message;
                } finally {
                    buttons.forEach((item) => {
                        item.disabled = false;
                    });
                }
            });

            $("copyOutput").addEventListener("click", async () => {
                await navigator.clipboard.writeText(outputEl.textContent);
                setStatus("Copied", "ok");
            });

            orgSelectEl.addEventListener("change", () => {
                $("orgId").value = orgSelectEl.value;
                $("projectId").value = "";
                $("monitorId").value = "";
                saveCache();
                setStatus(orgSelectEl.value ? "Organization selected" : "Manual org", "");
            });

            $("orgId").addEventListener("input", () => {
                const option = orgSelectEl.querySelector(
                    'option[value="' + orgId() + '"]',
                );
                orgSelectEl.value = option ? orgId() : "";
            });

            cacheFieldIds.forEach((id) => {
                const field = $(id);
                if (!field) return;
                field.addEventListener("input", saveCache);
                field.addEventListener("change", saveCache);
            });

            $("clearCache").addEventListener("click", () => {
                localStorage.removeItem(cacheKey);
                setStatus("Cache cleared", "ok");
            });

            $("clearOutput").addEventListener("click", () => {
                outputEl.textContent = "No request sent yet.";
                setRequestLine("-", "No request sent yet.");
                setStatus("Ready", "");
            });

            restoreCache();
        </script>
    </body>
</html>
