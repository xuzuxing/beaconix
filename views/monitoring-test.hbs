<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{{ title }}</title>
        <style>
            :root {
                color-scheme: light;
                --bg: #f5f7fa;
                --panel: #ffffff;
                --line: #d8e0ea;
                --line-strong: #bcc7d6;
                --ink: #132033;
                --muted: #64748b;
                --brand: #2563eb;
                --brand-dark: #1d4ed8;
                --bad: #b42318;
                --code: #0f172a;
            }
            * { box-sizing: border-box; }
            body {
                margin: 0;
                background: var(--bg);
                color: var(--ink);
                font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            }
            header { border-bottom: 1px solid var(--line); background: var(--panel); }
            .shell { width: min(1180px, calc(100vw - 32px)); margin: 0 auto; }
            .topbar {
                display: flex; align-items: center; justify-content: space-between;
                gap: 16px; min-height: 68px;
            }
            nav { display: flex; flex-wrap: wrap; gap: 10px; font-size: 13px; }
            nav a { color: var(--brand); text-decoration: none; }
            h1, h2 { margin: 0; }
            h1 { font-size: 22px; }
            h2 { font-size: 15px; }
            .subtitle { color: var(--muted); font-size: 13px; margin-top: 4px; }
            main {
                display: grid; grid-template-columns: 360px 1fr; gap: 18px;
                align-items: start; padding: 22px 0 40px;
            }
            section { border: 1px solid var(--line); border-radius: 8px; background: var(--panel); padding: 16px; }
            .stack { display: grid; gap: 12px; }
            .panel-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
            label { display: grid; gap: 6px; font-size: 13px; font-weight: 650; }
            input, select, textarea {
                width: 100%; border: 1px solid var(--line); border-radius: 6px;
                padding: 10px 11px; font: inherit; font-size: 14px; background: #fff; color: var(--ink);
            }
            textarea { min-height: 84px; resize: vertical; font-family: ui-monospace, Menlo, Consolas, monospace; }
            input:focus, select:focus, textarea:focus { border-color: var(--brand); outline: 3px solid #dbeafe; }
            .row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
            .actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
            button {
                min-height: 38px; border: 1px solid transparent; border-radius: 6px;
                padding: 9px 12px; color: #fff; background: var(--brand); cursor: pointer;
                font: inherit; font-size: 14px; font-weight: 700;
            }
            button.secondary { border-color: var(--line-strong); color: var(--ink); background: #fff; }
            button.danger { background: var(--bad); }
            button:hover { background: var(--brand-dark); }
            button.secondary:hover { background: #eef4ff; }
            .meta, .hint { color: var(--muted); font-size: 13px; line-height: 1.5; }
            .group { display: grid; gap: 12px; border-top: 1px solid var(--line); padding-top: 14px; }
            .group:first-of-type { border-top: 0; padding-top: 0; }
            .full { grid-column: 1 / -1; }
            pre {
                min-height: 460px; max-height: 700px; overflow: auto; margin: 0;
                border-radius: 8px; padding: 16px; background: var(--code); color: #d9e7ff;
                font-size: 13px; line-height: 1.55; white-space: pre-wrap; word-break: break-word;
            }
            .toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
            @media (max-width: 960px) {
                main, .panel-grid, .row { grid-template-columns: 1fr; }
                .topbar { align-items: flex-start; flex-direction: column; padding: 16px 0; }
            }
        </style>
    </head>
    <body>
        <header>
            <div class="shell topbar">
                <div>
                    <h1>{{ title }}</h1>
                    <div class="subtitle">Rendered at {{ renderedAt }}</div>
                </div>
                <nav>
                    <a href="/api/monitor-test">Monitor</a>
                    <a href="/api/monitoring-test">Monitoring</a>
                    <a href="/api/billing-test">Billing</a>
                    <a href="/api/upload-test">Upload</a>
                </nav>
            </div>
        </header>

        <main class="shell">
            <section class="stack">
                <h2>Context</h2>
                <label>
                    API Base
                    <input id="apiBase" value="{{ apiBase }}" />
                </label>
                <label>
                    Access Token
                    <textarea id="token" placeholder="JWT access token"></textarea>
                </label>
                <div class="row">
                    <label>
                        Organization ID
                        <input id="orgId" placeholder="org uuid" />
                    </label>
                    <label>
                        Project ID
                        <input id="projectId" placeholder="project uuid" />
                    </label>
                </div>
                <div class="row">
                    <label>
                        Status Page ID
                        <input id="statusPageId" placeholder="status page uuid" />
                    </label>
                    <label>
                        Public Slug
                        <input id="slug" placeholder="acme-status" />
                    </label>
                </div>
                <div class="row">
                    <label>
                        Probe ID
                        <input id="probeId" placeholder="probe uuid" />
                    </label>
                    <label>
                        Execution Status
                        <select id="execStatus">
                            <option value="">All</option>
                            <option value="SUCCESS">SUCCESS</option>
                            <option value="FAILED">FAILED</option>
                            <option value="TIMEOUT">TIMEOUT</option>
                            <option value="SKIPPED">SKIPPED</option>
                        </select>
                    </label>
                </div>
            </section>

            <div class="panel-grid">
                <section class="stack">
                    <div class="group">
                        <h2>Monitoring Overview</h2>
                        <div class="meta">/organizations/:orgId/monitoring/overview · /projects/:projectId/monitoring/overview</div>
                        <div class="actions">
                            <button data-action="orgOverview">Org Overview</button>
                            <button data-action="projectOverview" class="secondary">Project Overview</button>
                        </div>
                    </div>
                </section>

                <section class="stack">
                    <div class="group">
                        <h2>Status Pages</h2>
                        <div class="meta">/organizations/:orgId/status-pages · /status/:slug</div>
                        <label>
                            Title
                            <input id="pageTitle" value="Acme status" maxlength="100" />
                        </label>
                        <div class="row">
                            <label>
                                Slug (optional)
                                <input id="pageSlug" placeholder="auto-generate" maxlength="100" />
                            </label>
                            <label>
                                Description
                                <input id="pageDescription" placeholder="optional" maxlength="500" />
                            </label>
                        </div>
                        <label>
                            Visible Monitor IDs (JSON array)
                            <textarea id="visibleMonitorIds">[]</textarea>
                        </label>
                        <div class="row">
                            <label>
                                Show Latency
                                <select id="showLatency">
                                    <option value="true">true</option>
                                    <option value="false">false</option>
                                </select>
                            </label>
                            <label>
                                Show Uptime
                                <select id="showUptime">
                                    <option value="false">false</option>
                                    <option value="true">true</option>
                                </select>
                            </label>
                        </div>
                        <div class="actions">
                            <button data-action="listStatusPages" class="secondary">List</button>
                            <button data-action="createStatusPage">Create</button>
                            <button data-action="getStatusPage" class="secondary">Get</button>
                            <button data-action="updateStatusPage" class="secondary">Update</button>
                            <button data-action="deleteStatusPage" class="danger">Delete</button>
                            <button data-action="publicStatusPage" class="secondary">Public Page</button>
                        </div>
                    </div>
                </section>

                <section class="stack">
                    <div class="group">
                        <h2>Probe Executions</h2>
                        <div class="meta">/organizations/:orgId/probes/:id/executions</div>
                        <div class="actions">
                            <button data-action="listProbes" class="secondary">List Probes</button>
                            <button data-action="listExecutions">List Executions</button>
                        </div>
                    </div>
                </section>
            </div>

            <section class="stack full">
                <div class="toolbar">
                    <h2>Response</h2>
                    <button id="clearOutput" class="secondary">Clear</button>
                </div>
                <pre id="output">No request sent yet.</pre>
            </section>
        </main>

        <script>
            const $ = (id) => document.getElementById(id);
            const outputEl = $("output");
            const apiBase = () => $("apiBase").value.replace(/\/$/, "");
            const token = () => $("token").value.trim();
            const orgId = () => $("orgId").value.trim();

            function showResult(method, path, payload) {
                outputEl.textContent = `${method} ${path}\n\n${JSON.stringify(payload, null, 2)}`;
            }

            async function request(method, path, body) {
                const headers = { "Content-Type": "application/json" };
                if (token()) headers["Authorization"] = `Bearer ${token()}`;

                const res = await fetch(`${apiBase()}${path}`, {
                    method,
                    headers,
                    body: body === undefined ? undefined : JSON.stringify(body),
                });

                let data;
                try {
                    data = await res.json();
                } catch {
                    data = await res.text();
                }

                showResult(method, path, { status: res.status, data });
                return data;
            }

            function statusPagePayload() {
                let visibleMonitorIds = [];
                try {
                    visibleMonitorIds = JSON.parse($("visibleMonitorIds").value);
                } catch {
                    visibleMonitorIds = [];
                }

                return {
                    title: $("pageTitle").value,
                    slug: $("pageSlug").value || undefined,
                    description: $("pageDescription").value || undefined,
                    visibleMonitorIds,
                    showLatency: $("showLatency").value === "true",
                    showUptime: $("showUptime").value === "true",
                };
            }

            document.addEventListener("click", async (event) => {
                const action = event.target.getAttribute("data-action");
                if (!action) return;

                try {
                    if (action === "orgOverview") {
                        await request("GET", `/organizations/${orgId()}/monitoring/overview`);
                    } else if (action === "projectOverview") {
                        await request("GET", `/projects/${$("projectId").value.trim()}/monitoring/overview`);
                    } else if (action === "listStatusPages") {
                        await request("GET", `/organizations/${orgId()}/status-pages`);
                    } else if (action === "createStatusPage") {
                        await request("POST", `/organizations/${orgId()}/status-pages`, statusPagePayload());
                    } else if (action === "getStatusPage") {
                        await request("GET", `/organizations/${orgId()}/status-pages/${$("statusPageId").value.trim()}`);
                    } else if (action === "updateStatusPage") {
                        await request("PATCH", `/organizations/${orgId()}/status-pages/${$("statusPageId").value.trim()}`, statusPagePayload());
                    } else if (action === "deleteStatusPage") {
                        await request("DELETE", `/organizations/${orgId()}/status-pages/${$("statusPageId").value.trim()}`);
                    } else if (action === "publicStatusPage") {
                        await request("GET", `/status/${$("slug").value.trim()}`);
                    } else if (action === "listProbes") {
                        await request("GET", `/organizations/${orgId()}/probes`);
                    } else if (action === "listExecutions") {
                        const status = $("execStatus").value;
                        const query = status ? `?status=${status}` : "";
                        await request("GET", `/organizations/${orgId()}/probes/${$("probeId").value.trim()}/executions${query}`);
                    } else if (action === "clearOutput") {
                        outputEl.textContent = "No request sent yet.";
                    }
                } catch (error) {
                    outputEl.textContent = `Request failed\n\n${error.message}`;
                }
            });
        </script>
    </body>
</html>
