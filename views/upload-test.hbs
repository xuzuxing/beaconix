<html lang='zh-CN'>
    <head>
        <meta charset='utf-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1' />
        <title>{{title}}</title>
        <style>
            :root {
                color-scheme: light;
                --bg: #f5f7fa;
                --panel: #ffffff;
                --line: #d8e0ea;
                --line-strong: #bcc7d6;
                --ink: #132033;
                --muted: #64748b;
                --brand: #2563eb;
                --brand-dark: #1d4ed8;
                --bad: #b42318;
                --code: #0f172a;
            }
            * {
                box-sizing: border-box;
            }
            body {
                margin: 0;
                background: var(--bg);
                color: var(--ink);
                font-family:
                    Inter,
                    ui-sans-serif,
                    system-ui,
                    -apple-system,
                    BlinkMacSystemFont,
                    'Segoe UI',
                    sans-serif;
            }
            header {
                border-bottom: 1px solid var(--line);
                background: var(--panel);
            }
            .shell {
                width: min(1180px, calc(100vw - 32px));
                margin: 0 auto;
            }
            .topbar {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                min-height: 68px;
            }
            nav {
                display: flex;
                flex-wrap: wrap;
                gap: 10px;
                font-size: 13px;
            }
            nav a {
                color: var(--brand);
                text-decoration: none;
            }
            h1,
            h2 {
                margin: 0;
            }
            h1 {
                font-size: 22px;
            }
            h2 {
                font-size: 15px;
            }
            .subtitle,
            .hint {
                color: var(--muted);
                font-size: 13px;
                line-height: 1.5;
            }
            main {
                display: grid;
                grid-template-columns: 360px 1fr;
                gap: 18px;
                align-items: start;
                padding: 22px 0 40px;
            }
            section {
                border: 1px solid var(--line);
                border-radius: 8px;
                background: var(--panel);
                padding: 16px;
            }
            .stack {
                display: grid;
                gap: 12px;
            }
            .row {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
            }
            label {
                display: grid;
                gap: 6px;
                font-size: 13px;
                font-weight: 650;
            }
            input,
            select,
            textarea {
                width: 100%;
                border: 1px solid var(--line);
                border-radius: 6px;
                padding: 10px 11px;
                font: inherit;
                font-size: 14px;
                background: #fff;
                color: var(--ink);
            }
            textarea {
                min-height: 120px;
                resize: vertical;
                font-family: ui-monospace, Menlo, Consolas, monospace;
            }
            input:focus,
            select:focus,
            textarea:focus {
                border-color: var(--brand);
                outline: 3px solid #dbeafe;
            }
            .actions {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 10px;
            }
            .result-grid {
                display: grid;
                gap: 8px;
                padding: 10px;
                border: 1px solid var(--line);
                border-radius: 6px;
                background: #f8fafc;
                font-size: 13px;
            }
            .result-grid div {
                min-width: 0;
                overflow-wrap: anywhere;
            }
            .result-grid strong {
                color: var(--muted);
            }
            button {
                min-height: 38px;
                border: 1px solid transparent;
                border-radius: 6px;
                padding: 9px 12px;
                color: #fff;
                background: var(--brand);
                cursor: pointer;
                font: inherit;
                font-size: 14px;
                font-weight: 700;
            }
            button.secondary {
                border-color: var(--line-strong);
                color: var(--ink);
                background: #fff;
            }
            button.danger {
                background: var(--bad);
            }
            button:hover {
                background: var(--brand-dark);
            }
            button.secondary:hover {
                background: #eef4ff;
            }
            pre {
                min-height: 520px;
                max-height: 760px;
                overflow: auto;
                margin: 0;
                border-radius: 8px;
                padding: 16px;
                background: var(--code);
                color: #d9e7ff;
                font-size: 13px;
                line-height: 1.55;
                white-space: pre-wrap;
                word-break: break-word;
            }
            @media (max-width: 960px) {
                main,
                .row {
                    grid-template-columns: 1fr;
                }
                .topbar {
                    align-items: flex-start;
                    flex-direction: column;
                    padding: 16px 0;
                }
            }
        </style>
    </head>
    <body>
        <header>
            <div class='shell topbar'>
                <div>
                    <h1>{{title}}</h1>
                    <div class='subtitle'>Rendered at {{renderedAt}}</div>
                </div>
                <nav>
                    <a href='/api/monitor-test'>Monitor</a>
                    <a href='/api/monitoring-test'>Monitoring</a>
                    <a href='/api/billing-test'>Billing</a>
                    <a href='/api/upload-test'>Upload</a>
                </nav>
            </div>
        </header>

        <main class='shell'>
            <section class='stack'>
                <h2>Context</h2>
                <label>
                    API Base
                    <input id='apiBase' value='{{apiBase}}' />
                </label>
                <label>
                    Access Token
                    <textarea
                        id='token'
                        placeholder='JWT access token'
                    ></textarea>
                </label>
                <label>
                    Upload Directory
                    <input
                        id='directory'
                        placeholder='Optional, e.g. openchoreo or imports/raw'
                    />
                </label>
                <label>
                    File
                    <input id='file' type='file' />
                </label>
                <div class='actions'>
                    <button data-action='upload'>Upload</button>
                    <button data-action='open' class='secondary'>Open URL</button>
                </div>
                <div class='result-grid'>
                    <div><strong>Last URL:</strong>
                        <span id='lastUrl'>-</span></div>
                    <div><strong>Last File Key:</strong>
                        <span id='lastFileKey'>-</span></div>
                </div>
                <div class='hint'>
                    通用上传接口：`POST /api/attachments/upload`，字段名为
                    `file`，可选字段 `directory`。例如填 `openchoreo` 会写入
                    `storage/uploads/openchoreo/yyyy/mm/...`。需要 Bearer
                    token，不绑定 task，不写入 Attachment metadata。
                </div>
            </section>

            <section class='stack'>
                <h2>Response</h2>
                <pre id='output'>No request sent yet.</pre>
            </section>
        </main>

        <script>
            const $ = (id) => document.getElementById(id); const output =
            $('output'); const lastUrl = $('lastUrl'); const lastFileKey =
            $('lastFileKey'); const apiBase = () =>
            $('apiBase').value.replace(/\/$/, ''); const token = () =>
            $('token').value.trim(); const directory = () =>
            $('directory').value.trim(); let lastUploadUrl = ''; let
            lastUploadKey = ''; let lastUploadProvider = ''; let
            lastUploadBucket = ''; function requireToken() { if (!token()) {
            throw new Error('Access Token is required'); } } function
            headers(json = false) { const result = {}; if (json)
            result['content-type'] = 'application/json'; result.authorization =
            'Bearer ' + token(); return result; } async function
            readResponse(response) { const text = await response.text(); try {
            return text ? JSON.parse(text) : null; } catch { return text; } }
            async function request(method, path, options = {}) { requireToken();
            const response = await fetch(apiBase() + path, { method, headers: {
            ...headers(options.json), ...(options.headers || {}), }, body:
            options.body, }); const body = await readResponse(response);
            output.textContent = `${method} ${path}\n\n${JSON.stringify( {
            status: response.status, ok: response.ok, body }, null, 2, )}`;
            return { response, body }; } document.addEventListener('click',
            async (event) => { const button =
            event.target.closest('[data-action]'); if (!button) return; try {
            const action = button.dataset.action; if (action === 'upload') {
            const file = $('file').files[0]; if (!file) throw new Error('File is
            required'); const form = new FormData(); form.append('file', file);
            if (directory()) { form.append('directory', directory()); } const
            result = await request( 'POST', '/attachments/upload', { body: form
            }, ); const upload = result.body && result.body.data ?
            result.body.data : result.body; lastUploadUrl = upload && upload.url
            ? upload.url : ''; lastUploadKey = upload && upload.fileKey ?
            upload.fileKey : ''; lastUploadProvider = upload &&
            upload.storageProvider ? upload.storageProvider : '';
            lastUploadBucket = upload && upload.bucket ? upload.bucket : '';
            lastUrl.textContent = lastUploadUrl || '-'; lastFileKey.textContent
            = lastUploadKey || '-'; } else if (action === 'open') { if
            (lastUploadUrl) { window.open(lastUploadUrl, '_blank'); return; } if
            (!lastUploadKey) { throw new Error( 'No previewable object key
            returned by the last upload', ); } const params = new
            URLSearchParams({ key: lastUploadKey, }); if (lastUploadProvider) {
            params.set('provider', lastUploadProvider); } if (lastUploadBucket)
            { params.set('bucket', lastUploadBucket); } const response = await
            fetch( `${apiBase()}/attachments/object?${params.toString()}`, {
            headers: headers() }, ); if (!response.ok) { const body = await
            readResponse(response); throw new Error( JSON.stringify( { status:
            response.status, body, }, null, 2, ), ); } const blobUrl =
            URL.createObjectURL( await response.blob(), ); window.open(blobUrl,
            '_blank'); } } catch (error) { output.textContent = error.stack ||
            error.message; } });
        </script>
    </body>
</html>