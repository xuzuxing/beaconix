<html lang='zh-CN'>
    <head>
        <meta charset='utf-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1' />
        <title>{{title}}</title>
        <style>
            :root {
                color-scheme: light;
                --bg: #f5f7fa;
                --panel: #ffffff;
                --line: #d8e0ea;
                --ink: #132033;
                --muted: #64748b;
                --brand: #2563eb;
            }
            * {
                box-sizing: border-box;
            }
            body {
                margin: 0;
                background: var(--bg);
                color: var(--ink);
                font-family:
                    Inter,
                    ui-sans-serif,
                    system-ui,
                    -apple-system,
                    'Segoe UI',
                    sans-serif;
            }
            header {
                border-bottom: 1px solid var(--line);
                background: var(--panel);
            }
            .shell {
                width: min(1180px, calc(100vw - 32px));
                margin: 0 auto;
            }
            .topbar {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                min-height: 68px;
            }
            .title {
                font-weight: 600;
            }
            .subtitle {
                color: var(--muted);
                font-size: 12px;
            }
            nav {
                display: flex;
                flex-wrap: wrap;
                gap: 10px;
                font-size: 13px;
            }
            nav a {
                color: var(--brand);
                text-decoration: none;
            }
            main {
                padding: 24px 0 40px;
                display: grid;
                gap: 18px;
            }
            section {
                background: var(--panel);
                border: 1px solid var(--line);
                border-radius: 12px;
                padding: 16px;
            }
            h2 {
                margin: 0 0 12px;
                font-size: 15px;
            }
            label {
                display: block;
                font-size: 12px;
                color: var(--muted);
                margin-bottom: 10px;
            }
            input,
            textarea {
                width: 100%;
                margin-top: 4px;
                border: 1px solid var(--line);
                border-radius: 8px;
                padding: 8px;
                font: inherit;
                color: var(--ink);
                background: #fff;
            }
            textarea {
                min-height: 170px;
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-size: 12px;
            }
            .row {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
            }
            .actions {
                display: flex;
                gap: 8px;
                flex-wrap: wrap;
                margin-top: 8px;
            }
            button {
                border: 0;
                border-radius: 8px;
                padding: 8px 14px;
                background: var(--brand);
                color: #fff;
                font: inherit;
                cursor: pointer;
            }
            button.secondary {
                background: #e2e8f0;
                color: var(--ink);
            }
            pre {
                margin: 0;
                padding: 12px;
                background: #0f172a;
                color: #e2e8f0;
                border-radius: 8px;
                overflow: auto;
                max-height: 420px;
                font-size: 12px;
            }
            .hint {
                color: var(--muted);
                font-size: 12px;
                margin-top: 8px;
            }
        </style>
    </head>
    <body>
        <header>
            <div class='shell topbar'>
                <div>
                    <div class='title'>{{title}}</div>
                    <div class='subtitle'>Rendered at {{renderedAt}}</div>
                </div>
                <nav>
                    <a href='/api/monitor-test'>Monitor</a>
                    <a href='/api/monitoring-test'>Monitoring</a>
                    <a href='/api/billing-test'>Billing</a>
                    <a href='/api/upload-test'>Upload</a>
                    <a href='/api/rules-test'>Rules</a>
                </nav>
            </div>
        </header>

        <main class='shell'>
            <section>
                <h2>Context</h2>
                <div class='row'>
                    <label>
                        API Base
                        <input id='apiBase' value='{{apiBase}}' />
                    </label>
                    <label>
                        Organization ID
                        <input id='orgId' placeholder='org id' />
                    </label>
                </div>
                <label>
                    Access Token
                    <textarea
                        id='token'
                        placeholder='JWT access token'
                        style='min-height: 64px'
                    ></textarea>
                </label>
            </section>

            <section>
                <h2>Rule group</h2>
                <label>
                    Name
                    <input id='name' value='5xx 或高延迟' />
                </label>
                <label>
                    Tree (JSON)
                    <textarea id='tree'>{
  "type": "logic",
  "id": "root",
  "operator": "or",
  "children": [
    { "type": "condition", "id": "c1", "field": "statusCode", "operator": "statusClass", "value": "5" },
    { "type": "condition", "id": "c2", "field": "latency", "operator": "gt", "value": 3000 }
  ]
}</textarea>
                </label>
                <div class='actions'>
                    <button data-action='create'>校验并创建</button>
                    <button data-action='list' class='secondary'>
                        列出规则组
                    </button>
                    <button data-action='meta' class='secondary'>
                        字段元数据
                    </button>
                </div>
                <div class='hint'>
                    「校验并创建」调用
                    <code>POST /api/organizations/:orgId/rule-groups</code>；
                    规则树非法时后端返回 400 与具体原因（这就是规则组校验的报错）。
                </div>
            </section>

            <section>
                <h2>Response</h2>
                <pre id='output'>No request sent yet.</pre>
            </section>
        </main>

        <script>
            const $ = (id) => document.getElementById(id);
            const output = $('output');
            const apiBase = () => $('apiBase').value.replace(/\/$/, '');
            const token = () => $('token').value.trim();
            const orgId = () => $('orgId').value.trim();

            function headers(json) {
                const h = {};
                if (json) h['content-type'] = 'application/json';
                if (token()) h.authorization = 'Bearer ' + token();
                return h;
            }

            async function readResponse(response) {
                const text = await response.text();
                try {
                    return text ? JSON.parse(text) : null;
                } catch {
                    return text;
                }
            }

            async function request(label, method, path, body) {
                const response = await fetch(apiBase() + path, {
                    method,
                    headers: headers(body !== undefined),
                    body:
                        body === undefined ? undefined : JSON.stringify(body),
                });
                const parsed = await readResponse(response);
                output.textContent =
                    label +
                    '\n' +
                    method +
                    ' ' +
                    path +
                    '\n\n' +
                    JSON.stringify(
                        {
                            status: response.status,
                            ok: response.ok,
                            body: parsed,
                        },
                        null,
                        2,
                    );
                return { response, body: parsed };
            }

            document.addEventListener('click', async (event) => {
                const button = event.target.closest('[data-action]');
                if (!button) return;
                try {
                    const action = button.dataset.action;

                    if (action === 'meta') {
                        await request('字段元数据', 'GET', '/rule-meta');
                        return;
                    }

                    if (!orgId()) throw new Error('请先填 Organization ID');

                    if (action === 'list') {
                        await request(
                            '规则组列表',
                            'GET',
                            '/organizations/' + orgId() + '/rule-groups',
                        );
                        return;
                    }

                    if (action === 'create') {
                        const tree = JSON.parse($('tree').value);
                        await request(
                            '校验并创建',
                            'POST',
                            '/organizations/' + orgId() + '/rule-groups',
                            { name: $('name').value.trim(), tree },
                        );
                        return;
                    }
                } catch (error) {
                    output.textContent = error.stack || error.message;
                }
            });
        </script>
    </body>
</html>
