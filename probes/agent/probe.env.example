# Beacon probe agent — Docker Compose environment template.
#
#   cp probe.env.example probe.env        # probe.env is gitignored
#   docker compose --env-file probe.env up -d --build
#   docker compose --env-file probe.env logs -f
#
# Only BEACON_API_URL is required; first start prints a login URL, and the
# credential is stored in the probe-data volume.

BEACON_API_URL=https://api.example.com/api

# --- Optional -------------------------------------------------------------

# Redeem a one-time token from the web UI instead of the interactive login.
# PROBE_ENROLL_TOKEN=

# Probe cadence (defaults match the agent).
# PROBE_INTERVAL_SECONDS=60
# PROBE_TIMEOUT_MS=5000
# PROBE_MAX_RESULTS=100
# PROBE_CONCURRENCY=3

# Only for local testing against an http:// backend.
# PROBE_ALLOW_INSECURE=false

# Release / download source. Every start re-downloads the payload; set
# PROBE_AUTO_UPDATE=0 to reuse what is already in the volume.
# PROBE_VERSION=latest
# BEACON_DOWNLOAD_BASE=https://get.beaconix.app/probe
# PROBE_AUTO_UPDATE=1
# PROBE_FORCE_INSTALL=0
