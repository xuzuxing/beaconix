generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ENUMS
enum GlobalRole {
  SUPER_ADMIN
  USER
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_COMMENTED
  TASK_STATUS_CHANGED
  TASK_DUE_SOON
  TASK_OVERDUE
  SPRINT_STARTED
  SPRINT_COMPLETED
  PROJECT_ARCHIVED
  MEMBER_JOINED
  MEMBER_REMOVED
  MENTION
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  ARCHIVE
  INVITE
  JOIN
  LEAVE
  ASSIGN
  UNASSIGN
  ENABLE_2FA
  DISABLE_2FA
  REGENERATE_RECOVERY_CODES
  USE_RECOVERY_CODE
}

enum AttachmentSource {
  UPLOAD
  GOOGLE_DRIVE
  DROPBOX
  URL
}

enum AttachmentStorageProvider {
  LOCAL
  OSS
  EXTERNAL
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum CommentType {
  TEXT
  SYSTEM
}

// OTP PURPOSE
enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// USER
model User {
  id            String     @id @default(cuid())
  email         String     @unique
  password      String
  name          String
  avatarUrl     String?
  globalRole    GlobalRole @default(USER)
  isActive      Boolean    @default(true)
  emailVerified Boolean    @default(false)
  lastSeenAt    DateTime?

  // Two-factor authentication (TOTP). `twoFactorEnabled` is the fast path the
  // login flow checks; the secret itself lives in TwoFactorSecret.
  twoFactorEnabled   Boolean   @default(false)
  twoFactorEnabledAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  identities           UserIdentity[]
  ownedOrganizations   Organization[]        @relation("OrganizationOwner")
  memberships          Membership[]
  createdProjects      Project[]             @relation("ProjectCreator")
  createdTasks         Task[]                @relation("TaskCreator")
  assignedTasks        Task[]                @relation("TaskAssignee")
  comments             Comment[]
  notifications        Notification[]
  sentInvitations      Invitation[]          @relation("InvitationSender")
  auditLogs            AuditLog[]            @relation("AuditActor")
  taskWatchers         TaskWatcher[]
  taskActivities       TaskActivity[]        @relation("ActivityActor")
  createdLabels        Label[]               @relation("LabelCreator")
  attachments          Attachment[]
  refreshTokens        RefreshToken[]
  otpCodes             OtpCode[]
  orders               Order[]
  apiKeys              ApiKey[]              @relation("ApiKeyCreator")
  personalAccessTokens PersonalAccessToken[]
  twoFactorSecret        TwoFactorSecret?
  twoFactorRecoveryCodes TwoFactorRecoveryCode[]
  twoFactorChallenges    TwoFactorChallenge[]

  @@index([createdAt])
  @@index([isActive])
  @@index([globalRole])
  @@map("users")
}

// IDENTITY PROVIDER
enum IdentityProvider {
  WECHAT_WEB
  WECHAT_MINI
}

// USER IDENTITY (third-party login accounts bound to a Beacon user)
model UserIdentity {
  id        String           @id @default(cuid())
  userId    String
  provider  IdentityProvider
  openid    String
  unionid   String?
  nickname  String?
  avatarUrl String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, openid])
  @@index([userId])
  @@index([unionid])
  @@map("user_identities")
}

// OTP CODE (For email verification and password reset)
model OtpCode {
  id        String     @id @default(cuid())
  userId    String
  codeHash  String // bcrypt-hashed OTP
  purpose   OtpPurpose
  expiresAt DateTime
  usedAt    DateTime? // null = not yet used
  attempts  Int        @default(0) // track failed verification attempts
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

// REFRESH TOKEN (For stateless JWT authentication with refresh tokens)
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique // hashed refresh token
  expiresAt DateTime
  revokedAt DateTime? // null = still valid
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// TWO FACTOR AUTHENTICATION (user-level TOTP second factor)

// The encrypted TOTP shared secret for a user that has 2FA enabled.
model TwoFactorSecret {
  id        String   @id @default(cuid())
  userId    String   @unique
  secretEnc String // AES-256-GCM ciphertext, format: v1:<iv>:<tag>:<ciphertext>
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_secrets")
}

// One-shot recovery codes. Only the bcrypt hash is stored; a code is consumed
// by setting usedAt so it can never be replayed.
model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String // bcrypt hash of the plaintext recovery code
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("two_factor_recovery_codes")
}

// Short-lived opaque challenge. Used for both the login second step
// (purpose=LOGIN) and the setup handshake (purpose=SETUP, which additionally
// carries the pending secret in secretEnc).
model TwoFactorChallenge {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique // sha256 of the raw challenge / setup token
  purpose    String    @default("LOGIN")
  secretEnc  String? // encrypted pending secret, only for purpose=SETUP
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("two_factor_challenges")
}

// ORGANIZATION
model Organization {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  logoUrl     String?
  website     String?
  ownerId     String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Settings stored as JSON for flexibility
  settings Json? @default("{}")

  // Relations
  owner       User         @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  memberships Membership[]
  projects    Project[]
  invitations Invitation[]
  labels      Label[]
  auditLogs   AuditLog[]
  tasks       Task[]

  // Monitors
  monitors      Monitor[]
  probes        Probe[]
  channels      NotificationChannel[]
  statusPages   StatusPage[]
  subscriptions Subscription[]
  orders        Order[]
  apiKeys       ApiKey[]

  // 规则引擎
  ruleGroups RuleGroup[]

  @@index([ownerId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("organizations")
}

// MEMBERSHIP (Pivot: User <-> Organization)
model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(MEMBER)
  joinedAt       DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Tracks who invited this member
  invitedById String?

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([role])
  @@map("memberships")
}

// INVITATION
model Invitation {
  id             String           @id @default(cuid())
  email          String
  organizationId String
  role           MembershipRole   @default(MEMBER)
  status         InvitationStatus @default(PENDING)
  token          String           @unique @default(cuid())
  expiresAt      DateTime
  sentById       String
  acceptedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sentBy       User         @relation("InvitationSender", fields: [sentById], references: [id], onDelete: Cascade)

  @@unique([email, organizationId])
  @@index([organizationId])
  @@index([status])
  @@index([expiresAt])
  @@map("invitations")
}

// PROJECT
model Project {
  id             String        @id @default(cuid())
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  key            String // Short code e.g. "PROJ" used in task identifiers like PROJ-42
  organizationId String
  createdById    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  sprints      Sprint[]
  tasks        Task[]
  labels       Label[]
  auditLogs    AuditLog[]
  monitors     Monitor[]
  ruleGroups   RuleGroup[]

  // Enforce unique project key per organization (e.g. no two "PROJ" in same org)
  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([status])
  @@index([organizationId, status])
  @@index([createdById])
  @@index([deletedAt])
  @@map("projects")
}

// SPRINT
model Sprint {
  id        String       @id @default(cuid())
  name      String
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  status    SprintStatus @default(PLANNED)
  projectId String
  order     Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@index([status])
  @@index([projectId, status])
  @@map("sprints")
}

// TASK
model Task {
  id                String       @id @default(cuid())
  number            Int // Auto-incremented task number per project (e.g., PROJ-42)
  title             String
  description       String?
  priority          TaskPriority @default(MEDIUM)
  status            TaskStatus   @default(TODO)
  storyPoints       Int? // Agile story points estimation
  dueDate           DateTime?
  completedAt       DateTime?
  // 提醒去重标记：置位后同一轮提醒不会重复发送（改 dueDate 时重置）
  dueSoonNotifiedAt DateTime?
  overdueNotifiedAt DateTime?

  // Multi-tenant isolation fields
  organizationId String
  projectId      String
  sprintId       String? // Nullable: tasks can exist in backlog (no sprint)
  createdById    String?
  assignedToId   String?

  // Self-referencing for subtasks
  parentTaskId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint       Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  parentTask   Task?        @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subTasks     Task[]       @relation("SubTasks")

  comments     Comment[]
  attachments  Attachment[]
  labels       TaskLabel[]
  watchers     TaskWatcher[]
  activities   TaskActivity[]
  dependencies TaskDependency[] @relation("DependentTask")
  dependents   TaskDependency[] @relation("DependencyTask")

  @@unique([projectId, number])
  @@index([status])
  @@index([priority])
  @@index([projectId])
  @@index([organizationId])
  @@index([sprintId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([dueDate])
  @@index([deletedAt])
  @@index([organizationId, status])
  @@index([projectId, sprintId])
  @@index([projectId, status])
  @@map("tasks")
}

// TASK DEPENDENCY (Task blocks another Task)
model TaskDependency {
  id               String   @id @default(cuid())
  dependentTaskId  String // The task that is blocked
  dependencyTaskId String // The task that blocks it
  createdAt        DateTime @default(now())

  dependentTask  Task @relation("DependentTask", fields: [dependentTaskId], references: [id], onDelete: Cascade)
  dependencyTask Task @relation("DependencyTask", fields: [dependencyTaskId], references: [id], onDelete: Cascade)

  @@unique([dependentTaskId, dependencyTaskId])
  @@index([dependentTaskId])
  @@index([dependencyTaskId])
  @@map("task_dependencies")
}

// TASK WATCHER (Users watching a task for notifications)
model TaskWatcher {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@map("task_watchers")
}

// TASK ACTIVITY LOG (Timeline of all task events)
model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String?
  action    String // e.g. "changed status from TODO to IN_PROGRESS"
  field     String? // Which field changed
  oldValue  String?
  newValue  String?
  meta      Json?    @default("{}")
  createdAt DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([actorId])
  @@index([createdAt])
  @@map("task_activities")
}

// COMMENT
model Comment {
  id        String      @id @default(cuid())
  body      String
  type      CommentType @default(TEXT)
  taskId    String
  authorId  String?
  isEdited  Boolean     @default(false)
  deletedAt DateTime?

  // Self-referencing for threaded replies
  parentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  task    Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author  User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies Comment[] @relation("CommentReplies")

  @@index([taskId])
  @@index([authorId])
  @@index([parentId])
  @@index([deletedAt])
  @@map("comments")
}

// ATTACHMENT
model Attachment {
  id           String           @id @default(cuid())
  filename     String
  mimeType     String
  size         Int // bytes
  url          String
  fileKey      String? // Storage object key — used for object deletion
  storageProvider AttachmentStorageProvider @default(LOCAL)
  bucket       String?
  checksum     String?
  source       AttachmentSource @default(UPLOAD)
  taskId       String
  uploadedById String?

  createdAt DateTime @default(now())

  task       Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@map("attachments")
}

// SETTING
model Setting {
  key         String           @id
  name        String
  value       Json
  valueType   SettingValueType
  description String?
  isSecret    Boolean          @default(false)
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isSecret])
  @@map("settings")
}

// LABEL
model Label {
  id             String  @id @default(cuid())
  name           String
  color          String // Hex color e.g. #FF5733
  organizationId String
  projectId      String? // Optional: org-wide labels have no projectId
  createdById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("LabelCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tasks        TaskLabel[]

  @@unique([name, organizationId, projectId])
  @@index([organizationId])
  @@index([projectId])
  @@map("labels")
}

// TASK LABEL (Pivot: Task <-> Label)
model TaskLabel {
  taskId    String
  labelId   String
  createdAt DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([taskId])
  @@index([labelId])
  @@map("task_labels")
}

// NOTIFICATION
model Notification {
  id           String           @id @default(cuid())
  userId       String
  type         NotificationType
  title        String
  body         String?
  isRead       Boolean          @default(false)
  readAt       DateTime?
  // Generic resource pointer
  resourceType String? // e.g. "Task", "Comment", "Sprint"
  resourceId   String? // UUID of the related resource
  meta         Json?            @default("{}")

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@index([resourceType, resourceId])
  @@map("notifications")
}

// AUDIT LOG (Immutable log of all important actions across the platform)
model AuditLog {
  id             String      @id @default(cuid())
  actorId        String?
  organizationId String?
  projectId      String?
  action         AuditAction
  entity         String // Model name: "Task", "Project", "Membership", etc.
  entityId       String // UUID of affected entity
  before         Json? // Snapshot before change
  after          Json? // Snapshot after change
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime    @default(now())

  actor        User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([organizationId])
  @@index([projectId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==================== MONITORING ====================

enum MonitorType {
  HTTP
  TCP
}

enum MonitorStatus {
  UNKNOWN
  UP
  DEGRADED
  DOWN
  PAUSED
}

enum ProbeScope {
  SYSTEM
  TENANT
}

enum ProbeProvider {
  TENCENT
  ALIYUN
  CUSTOM
}

enum ProbeStatus {
  ONLINE
  OFFLINE
}

enum CheckSource {
  LOCAL
  PROBE
}

enum ExecutionTrigger {
  SCHEDULED
  MANUAL
  CALLBACK
}

enum ExecutionStatus {
  SUCCESS
  FAILED
  TIMEOUT
  SKIPPED
}

enum NotificationChannelType {
  FEISHU
  WECOM
  DINGTALK
  WECHAT_SUBSCRIBE
  EMAIL
}

enum NotificationStatus {
  SUCCESS
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentChannel {
  WECHAT
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// 监控目标
model Monitor {
  id                 String      @id @default(cuid())
  organizationId     String
  projectId          String
  name               String
  type               MonitorType
  target             String
  interval           Int         @default(60)
  timeout            Int         @default(5000)
  expectedStatus     Int         @default(200)
  failureThreshold   Int         @default(3)
  checkSsl           Boolean     @default(false)
  sslExpiryThreshold Int         @default(30)
  enabled            Boolean     @default(true)
  configRevision     Int         @default(1)
  historyRevision    Int         @default(0)

  // 可用率告警（内嵌阈值告警）：最近 N 次检查可用率 < 阈值且连续失败达阈值时报警
  availabilityEnabled   Boolean @default(false)
  availabilityThreshold Float?  @default(90) // 可用率阈值 %，< 该值触发
  availabilityWindow    Int?    @default(10) // 统计窗口：最近 N 次检查

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  state        MonitorState?
  probes       MonitorProbe[]
  checkLogs    CheckLog[]
  executions   ProbeExecution[]
  // 该 monitor 绑定的通知渠道（多选）；为空时回退组织全部启用渠道
  notificationChannels MonitorNotificationChannel[]
  // 该 monitor 绑定的嵌套规则组（高级模式）
  ruleBindings MonitorRuleBinding[]

  @@index([organizationId])
  @@index([projectId])
  @@index([enabled])
  @@index([projectId, enabled])
  @@index([deletedAt])
  @@map("monitors")
}

// 监控状态（独立存储，避免频繁更新主表）
model MonitorState {
  monitorId          String         @id @default(cuid())
  status             MonitorStatus  @default(UNKNOWN)
  failCount          Int            @default(0)
  lastCheckAt        DateTime?
  // 最近一次"本地检测"时间（探针回调不会推进它），调度到期判定只看这一列
  lastLocalCheckAt   DateTime?
  lastError          String?
  lastLatency        Int?
  lastNotifiedStatus MonitorStatus?
  sslExpiresAt       DateTime?
  sslDaysRemaining   Int?
  sslIssuer          String?
  sslSubject         String?
  sslLastNotifiedAt  DateTime?
  // 最近一次可用率告警的发送时间（信息用途）
  lastAvailabilityAlertAt DateTime?
  // 是否处于可用率告警状态：命中时置真并只告警一次，恢复时发恢复通知并置假
  availabilityAlertActive Boolean    @default(false)
  connectivityFailCount Int          @default(0)
  lastAppliedObservationAt DateTime?
  lastAppliedObservationId String?
  updatedAt          DateTime       @updatedAt

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@map("monitor_states")
}

// monitor 与通知渠道的多对多绑定（可用率告警发送目标）
model MonitorNotificationChannel {
  monitorId String
  channelId String
  createdAt DateTime @default(now())

  monitor Monitor             @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  channel NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([monitorId, channelId])
  @@index([monitorId])
  @@index([channelId])
  @@map("monitor_notification_channels")
}

// ==================== 规则引擎（嵌套规则） ====================

// 规则组：一棵逻辑树（LogicNode | ConditionNode 的 JSON）
model RuleGroup {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String? // null = 组织级，非空 = 项目级
  name           String
  description    String?
  // 整棵逻辑树：LogicNode | ConditionNode 的 JSON
  tree           Json
  // 冗余：树里用到的字段名，便于按字段反查规则
  fieldsUsed     String[] @default([])
  enabled        Boolean  @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bindings     MonitorRuleBinding[]

  @@index([organizationId])
  @@index([projectId])
  @@index([enabled])
  @@index([deletedAt])
  @@map("rule_groups")
}

// monitor 与规则组的绑定
model MonitorRuleBinding {
  id          String  @id @default(cuid())
  monitorId   String
  ruleGroupId String
  // 同一个 monitor 绑定多个规则组时的优先级，数字越大越先求值
  priority    Int     @default(0)
  enabled     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  monitor   Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  ruleGroup RuleGroup @relation(fields: [ruleGroupId], references: [id], onDelete: Cascade)

  @@unique([monitorId, ruleGroupId])
  @@index([monitorId])
  @@index([ruleGroupId])
  @@map("monitor_rule_bindings")
}

// 探针
model Probe {
  id                       String        @id @default(cuid())
  scope                    ProbeScope    @default(TENANT)
  organizationId           String?
  name                     String
  provider                 ProbeProvider
  region                   String
  callbackUrl              String
  enabled                  Boolean       @default(true)
  lastHeartbeat            DateTime?
  // 探针最近一次上报的心跳周期（秒）；离线阈值按它的倍数推导，null = 未上报过
  heartbeatIntervalSeconds Int?
  status                   ProbeStatus   @default(OFFLINE)
  maxTenants               Int?          @default(0)
  priority                 Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  monitors     MonitorProbe[]
  results      ProbeResult[]
  executions   ProbeExecution[]
  secrets      ProbeSecret[]

  @@index([scope])
  @@index([organizationId])
  @@index([enabled])
  @@map("probes")
}

// 探针凭据：哈希存储（sha256），支持平滑轮换——同一探针在一次轮换期间
// 新旧 secret 并存，旧的在宽限期后由 expiresAt 自动失效。
model ProbeSecret {
  id           String    @id @default(cuid())
  probeId      String
  secretHash   String    @unique // sha256 hex of the raw secret
  secretPrefix String // e.g. tnt_1a2b3c4d — for display only
  // 宽限期截止：null = 不过期（当前有效）；轮换后的旧 secret 在此刻失效
  expiresAt    DateTime?
  revokedAt    DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  probe Probe @relation(fields: [probeId], references: [id], onDelete: Cascade)

  @@index([probeId])
  @@index([revokedAt])
  @@index([expiresAt])
  @@map("probe_secrets")
}

// 监控-探针多对多
model MonitorProbe {
  monitorId String
  probeId   String
  createdAt DateTime @default(now())

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  probe   Probe   @relation(fields: [probeId], references: [id], onDelete: Cascade)

  @@id([monitorId, probeId])
  @@index([monitorId])
  @@index([probeId])
  @@map("monitor_probes")
}

// 探针检测结果
model ProbeResult {
  id        String   @id @default(cuid())
  probeId   String
  probeRefId String?
  monitorId String?
  organizationId String?
  projectId String?
  monitorType MonitorType?
  configRevision Int?
  reportId String?
  payloadHash String?
  receivedAt DateTime @default(now())
  appliedAt DateTime?
  target    String
  success   Boolean
  error     String?
  // 探针观测到的实际 HTTP 状态码（可选）
  statusCode Int?
  latency   Int
  checkedAt DateTime @default(now())

  probe Probe? @relation(fields: [probeRefId], references: [id], onDelete: SetNull)

  @@unique([probeId, reportId])
  @@index([projectId, monitorId, checkedAt])
  @@index([projectId, probeId, checkedAt])
  @@index([target, checkedAt])
  @@index([probeId, checkedAt])
  @@index([checkedAt])
  @@map("probe_results")
}

// 探针和检测执行日志
model ProbeExecution {
  id           String           @id @default(cuid())
  probeId      String?
  monitorId    String?
  target       String
  trigger      ExecutionTrigger
  status       ExecutionStatus
  success      Boolean
  latency      Int?
  error        String?
  requestMeta  Json?            @default("{}")
  responseMeta Json?            @default("{}")
  executedAt   DateTime         @default(now())

  probe   Probe?   @relation(fields: [probeId], references: [id], onDelete: SetNull)
  monitor Monitor? @relation(fields: [monitorId], references: [id], onDelete: SetNull)

  @@index([probeId, executedAt])
  @@index([monitorId, executedAt])
  @@index([status])
  @@index([executedAt])
  @@map("probe_executions")
}

// 检测历史
model CheckLog {
  id             String      @id @default(cuid())
  monitorId      String
  monitorRefId   String?
  organizationId String?
  projectId      String?
  monitorType    MonitorType?
  observationId  String? @unique
  configRevision Int?
  serviceVerdict String?
  localServiceVerdict String?
  sslVerdict String?
  // 最终判定结论（本地结果与探针结果聚合后）
  success        Boolean
  // 本地探测的原始结果；探针回调写入时记录本地最近一次结果，本地检测时等于 success
  localSuccess   Boolean?
  // 本地失败但探针成功时置真，便于区分"探针救回"的判定
  rescuedByProbe Boolean     @default(false)
  latency        Int
  error          String?
  // 实际 HTTP 状态码（服务器有响应时），供规则与历史使用
  statusCode     Int?
  // 规则校验结论：本轮规则树是否命中（命中=异常）；无绑定规则组时回退为 !success
  ruleMatched    Boolean     @default(false)
  // 命中的规则组 ID，便于追溯「为什么触发」
  ruleGroupIds   String[]    @default([])
  source         CheckSource @default(LOCAL)
  checkedAt      DateTime    @default(now())

  monitor Monitor? @relation(fields: [monitorRefId], references: [id], onDelete: SetNull)

  @@index([projectId, source, checkedAt])
  @@index([projectId, source, monitorType, checkedAt])
  @@index([monitorId, checkedAt])
  @@index([checkedAt])
  @@map("check_logs")
}

// 通知渠道配置
model NotificationChannel {
  id             String                  @id @default(cuid())
  organizationId String
  type           NotificationChannelType
  name           String
  config         Json                    @default("{}")
  enabled        Boolean                 @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  logs         NotificationLog[]
  monitors     MonitorNotificationChannel[]

  @@index([organizationId])
  @@index([enabled])
  @@map("notification_channels")
}

// 通知日志
model NotificationLog {
  id        String             @id @default(cuid())
  monitorId String
  channelId String
  channelRefId String?
  eventId String?
  deliveryId String?
  phase String?
  attempt Int?
  status    NotificationStatus
  error     String?
  sentAt    DateTime           @default(now())

  channel NotificationChannel? @relation(fields: [channelRefId], references: [id], onDelete: SetNull)

  @@index([monitorId, sentAt])
  @@index([channelId, sentAt])
  @@index([eventId, sentAt])
  @@map("notification_logs")
}

model MonitoringCoverage {
  projectId String @id
  checksStartedAt DateTime @default(now())
  countsStartedAt DateTime @default(now())
  probeStartedAt DateTime @default(now())
  alertsStartedAt DateTime @default(now())
  version Int @default(1)
  @@map("monitoring_coverage")
}

model MonitorHistory {
  id String @id @default(cuid())
  monitorId String
  organizationId String
  projectId String
  enabled Boolean
  deleted Boolean
  status MonitorStatus
  effectiveAt DateTime @default(now())
  revision Int
  cause String
  @@unique([monitorId, revision])
  @@index([projectId, effectiveAt])
  @@index([monitorId, effectiveAt, revision])
  @@map("monitor_history")
}

model AlertEvent {
  id String @id @default(cuid())
  monitorId String
  organizationId String
  projectId String
  monitorName String
  target String
  kind String
  level String
  status String @default("ongoing")
  suppressedReason String?
  reason String
  threshold Float?
  actual Float?
  unit String?
  message String?
  origin String @default("OBSERVED")
  latestEvidence Json @default("{}")
  lifecycleRevision Int @default(1)
  startedAt DateTime @default(now())
  resolvedAt DateTime?
  durationSeconds Int?
  firstNotifiedAt DateTime?
  updatedAt DateTime @updatedAt
  deliveries AlertDelivery[]
  @@index([projectId, updatedAt, id])
  @@index([projectId, status])
  @@map("alert_events")
}

model AlertDelivery {
  id String @id @default(cuid())
  eventId String
  eventRevision Int
  phase String
  channelId String
  payload Json
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  leaseToken String?
  deliveredAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  event AlertEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  @@unique([eventId, eventRevision, phase, channelId])
  @@index([status, nextAttemptAt])
  @@map("alert_deliveries")
}

// 状态页
model StatusPage {
  id                String   @id @default(cuid())
  organizationId    String
  slug              String   @unique
  title             String
  description       String?
  visibleMonitorIds String[] @default([])
  showLatency       Boolean  @default(true)
  showUptime        Boolean  @default(false)
  enabled           Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([slug])
  @@map("status_pages")
}

// ==================== DEVELOPER ACCESS ====================

// 组织级 API Key：程序化访问 Beacon 监控能力（明文只在创建时返回一次）
model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  keyPrefix      String // e.g. bk_org_1a2b3c4d — for display only
  keyHash        String    @unique // SHA-256 of the full key
  scopes         String[]  @default([])
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdById])
  @@index([revokedAt])
  @@map("api_keys")
}

// 用户级 Personal Access Token：可吊销的用户 JWT（claims 带 kind=pat + patId）
model PersonalAccessToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  tokenHash  String    @unique // SHA-256 of the raw token
  scopes     String[]  @default([])
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([revokedAt])
  @@map("personal_access_tokens")
}

// ==================== BILLING ====================

// 套餐定义
model Plan {
  id           String  @id @default(cuid())
  code         String  @unique
  name         String
  description  String?
  price        Int     @default(0)
  durationDays Int     @default(30)
  sortOrder    Int     @default(0)

  maxMonitors Int @default(5)
  maxProbes   Int @default(0)
  maxApiKeys  Int @default(5)
  maxMembers  Int @default(3)
  maxChannels Int @default(1)
  minInterval Int @default(300)

  allowTenantProbe Boolean @default(false)
  allowStatusPage  Boolean @default(false)

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  orders        Order[]

  @@index([code])
  @@map("plans")
}

// 订阅栈
model Subscription {
  id             String @id @default(cuid())
  organizationId String
  planId         String

  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime
  expiresAt DateTime
  autoRenew Boolean            @default(false)

  orderId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])
  order        Order?       @relation(fields: [orderId], references: [id])

  @@index([organizationId, status])
  @@index([expiresAt])
  @@map("subscriptions")
}

// 订单
model Order {
  id             String @id @default(cuid())
  orderNo        String @unique
  organizationId String
  planId         String
  userId         String

  amount       Int
  currency     String @default("CNY")
  durationDays Int

  status      OrderStatus @default(PENDING)
  paidAt      DateTime?
  cancelledAt DateTime?
  expiresAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  plan         Plan          @relation(fields: [planId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  payment      Payment?
  subscription Subscription?

  @@index([organizationId])
  @@index([status])
  @@index([expiresAt])
  @@map("orders")
}

// 支付记录
model Payment {
  id            String         @id @default(cuid())
  orderId       String         @unique
  channel       PaymentChannel
  transactionId String?        @unique
  prepayId      String?
  amount        Int
  status        PaymentStatus  @default(PENDING)
  paidAt        DateTime?
  rawCallback   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([transactionId])
  @@map("payments")
}
