generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ENUMS
enum GlobalRole {
  SUPER_ADMIN
  USER
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectRole {
  VIEWER
  MEMBER
  ADMIN
}

enum InvitationIssuerType {
  LEGACY
  ORGANIZATION
  PLATFORM
}

enum NotificationAccessScope {
  UNKNOWN
  ACCOUNT
  INVITATION
  ORGANIZATION
  PROJECT
}

enum AttachmentVisibility {
  UNKNOWN
  PRIVATE
  EXTERNAL
  PUBLIC
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_COMMENTED
  TASK_STATUS_CHANGED
  TASK_DUE_SOON
  TASK_OVERDUE
  SPRINT_STARTED
  SPRINT_COMPLETED
  PROJECT_ARCHIVED
  MEMBER_JOINED
  MEMBER_REMOVED
  MENTION
  INVITATION_RECEIVED
  INVITATION_ACCEPTED
  INVITATION_DECLINED
  INVITATION_REVOKED
  INVITATION_EXPIRED
  MEMBER_ROLE_CHANGED
  MEMBER_LEFT
  OWNERSHIP_TRANSFERRED
  ORGANIZATION_DELETED
  ORGANIZATION_RESTORED
  TASK_UNASSIGNED
  TASK_DELETED
  TASK_RESTORED
  TASK_SPRINT_CHANGED
  TASK_DEPENDENCY_CHANGED
  TASK_UNBLOCKED
  COMMENT_REPLIED
  PROJECT_DELETED
  PROJECT_RESTORED
  SPRINT_DELETED
  PASSWORD_CHANGED
  PASSWORD_RESET_COMPLETED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  TWO_FACTOR_RECOVERY_CODE_USED
  TWO_FACTOR_RECOVERY_CODES_REGENERATED
  PAYMENT_SUCCEEDED
  PAYMENT_REFUNDED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  MONITOR_CAPACITY_GRACE_STARTED
  MONITOR_CAPACITY_GRACE_ENDING
  MONITOR_CAPACITY_LIMITED
  MONITOR_CAPACITY_RESTORED
  MONITOR_ALERT
  MONITOR_RECOVERED
  ALERT_DELIVERY_FAILED_SUMMARY
  API_KEY_CREATED
  API_KEY_REVOKED
  PERSONAL_ACCESS_TOKEN_CREATED
  PERSONAL_ACCESS_TOKEN_REVOKED
  PROBE_ENROLLED
  PROBE_SECRET_ROTATED
  PROBE_CREDENTIAL_REVOKED
  TICKET_CREATED
  TICKET_REPLIED
  TICKET_STATUS_CHANGED
  TICKET_ASSIGNED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  ARCHIVE
  INVITE
  JOIN
  LEAVE
  ASSIGN
  UNASSIGN
  ENABLE_2FA
  DISABLE_2FA
  REGENERATE_RECOVERY_CODES
  USE_RECOVERY_CODE
}

enum AttachmentSource {
  UPLOAD
  GOOGLE_DRIVE
  DROPBOX
  URL
}

enum AttachmentStorageProvider {
  LOCAL
  OSS
  EXTERNAL
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum CommentType {
  TEXT
  SYSTEM
}

// OTP PURPOSE
enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// USER
model User {
  id            String     @id @default(cuid())
  email         String     @unique
  password      String
  name          String
  avatarUrl     String?
  globalRole    GlobalRole @default(USER)
  platformAuthorityVersion Int @default(0)
  isActive      Boolean    @default(true)
  emailVerified Boolean    @default(false)
  lastSeenAt    DateTime?

  // Two-factor authentication (TOTP). `twoFactorEnabled` is the fast path the
  // login flow checks; the secret itself lives in TwoFactorSecret.
  twoFactorEnabled   Boolean   @default(false)
  twoFactorEnabledAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  identities           UserIdentity[]
  ownedOrganizations   Organization[]        @relation("OrganizationOwner")
  memberships          Membership[]
  grantedProjectMemberships ProjectMembership[] @relation("ProjectGrantActor")
  createdProjects      Project[]             @relation("ProjectCreator")
  createdTasks         Task[]                @relation("TaskCreator")
  assignedTasks        Task[]                @relation("TaskAssignee")
  comments             Comment[]
  notifications        Notification[]
  sentInvitations      Invitation[]          @relation("InvitationSender")
  auditLogs            AuditLog[]            @relation("AuditActor")
  taskWatchers         TaskWatcher[]
  taskActivities       TaskActivity[]        @relation("ActivityActor")
  createdLabels        Label[]               @relation("LabelCreator")
  attachments          Attachment[]
  refreshTokens        RefreshToken[]
  otpCodes             OtpCode[]
  orders               Order[]
  apiKeys              ApiKey[]              @relation("ApiKeyCreator")
  personalAccessTokens PersonalAccessToken[]
  twoFactorSecret        TwoFactorSecret?
  twoFactorRecoveryCodes TwoFactorRecoveryCode[]
  twoFactorChallenges    TwoFactorChallenge[]

  // Platform support tickets
  tickets          Ticket[]         @relation("TicketAuthor")
  assignedTickets  Ticket[]         @relation("TicketAssignee")
  ticketReplies    TicketReply[]    @relation("TicketReplyAuthor")
  ticketActivities TicketActivity[] @relation("TicketActivityActor")

  @@index([createdAt])
  @@index([isActive])
  @@index([globalRole])
  @@map("users")
}

// IDENTITY PROVIDER
enum IdentityProvider {
  WECHAT_WEB
  WECHAT_MINI
}

// USER IDENTITY (third-party login accounts bound to a Beacon user)
model UserIdentity {
  id        String           @id @default(cuid())
  userId    String
  provider  IdentityProvider
  openid    String
  unionid   String?
  nickname  String?
  avatarUrl String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, openid])
  @@index([userId])
  @@index([unionid])
  @@map("user_identities")
}

// OTP CODE (For email verification and password reset)
model OtpCode {
  id        String     @id @default(cuid())
  userId    String
  codeHash  String // bcrypt-hashed OTP
  purpose   OtpPurpose
  expiresAt DateTime
  usedAt    DateTime? // null = not yet used
  attempts  Int        @default(0) // track failed verification attempts
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

// REFRESH TOKEN (For stateless JWT authentication with refresh tokens)
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique // hashed refresh token
  expiresAt DateTime
  revokedAt DateTime? // null = still valid
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// TWO FACTOR AUTHENTICATION (user-level TOTP second factor)

// The encrypted TOTP shared secret for a user that has 2FA enabled.
model TwoFactorSecret {
  id        String   @id @default(cuid())
  userId    String   @unique
  secretEnc String // AES-256-GCM ciphertext, format: v1:<iv>:<tag>:<ciphertext>
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_secrets")
}

// One-shot recovery codes. Only the bcrypt hash is stored; a code is consumed
// by setting usedAt so it can never be replayed.
model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String // bcrypt hash of the plaintext recovery code
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("two_factor_recovery_codes")
}

// Short-lived opaque challenge. Used for both the login second step
// (purpose=LOGIN) and the setup handshake (purpose=SETUP, which additionally
// carries the pending secret in secretEnc).
model TwoFactorChallenge {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique // sha256 of the raw challenge / setup token
  purpose    String    @default("LOGIN")
  secretEnc  String? // encrypted pending secret, only for purpose=SETUP
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("two_factor_challenges")
}

// ORGANIZATION
model Organization {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  logoUrl     String?
  website     String?
  ownerId     String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Settings stored as JSON for flexibility
  settings Json? @default("{}")

  // Cursor for effective monitor-capacity transitions (not subscription rows).
  monitorCapacityPlanId     String?
  monitorCapacityLimit      Int?
  monitorCapacityObservedAt DateTime?

  // Relations
  owner       User         @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  memberships Membership[]
  projects    Project[]
  invitations Invitation[]
  labels      Label[]
  auditLogs   AuditLog[]
  tasks       Task[]

  // Monitors
  monitors      Monitor[]
  probes        Probe[]
  channels      NotificationChannel[]
  statusPages   StatusPage[]
  subscriptions Subscription[]
  orders        Order[]
  apiKeys       ApiKey[]
  monitorCapacityCycles MonitorCapacityCycle[]

  // 规则引擎
  ruleGroups RuleGroup[]

  // 平台工单（仅作为提交人所属组织的快照，不参与权限）
  tickets Ticket[]

  @@index([ownerId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("organizations")
}

// MEMBERSHIP (Pivot: User <-> Organization)
model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(MEMBER)
  projectPermissionsVersion Int @default(0)
  joinedAt       DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Tracks who invited this member
  invitedById String?

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectMemberships ProjectMembership[]

  @@unique([id, organizationId])
  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([role])
  @@map("memberships")
}

// INVITATION
model Invitation {
  id             String           @id @default(cuid())
  email          String
  organizationId String
  role           MembershipRole   @default(MEMBER)
  status         InvitationStatus @default(PENDING)
  token          String           @unique @default(cuid())
  expiresAt      DateTime
  sentById       String
  acceptedAt     DateTime?
  issuerType InvitationIssuerType @default(LEGACY)
  issuerMembershipId String?
  issuerAuthorityVersion Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sentBy       User         @relation("InvitationSender", fields: [sentById], references: [id], onDelete: Cascade)
  projectGrants InvitationProjectGrant[]

  @@unique([id, organizationId])
  @@unique([email, organizationId])
  @@index([organizationId])
  @@index([status])
  @@index([expiresAt])
  @@map("invitations")
}

// PROJECT
model Project {
  id             String        @id @default(cuid())
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  key            String // Short code e.g. "PROJ" used in task identifiers like PROJ-42
  organizationId String
  createdById    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  sprints      Sprint[]
  tasks        Task[]
  labels       Label[]
  auditLogs    AuditLog[]
  monitors     Monitor[]
  ruleGroups   RuleGroup[]
  memberships ProjectMembership[]
  invitationGrants InvitationProjectGrant[]

  @@unique([id, organizationId])
  // Enforce unique project key per organization (e.g. no two "PROJ" in same org)
  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([status])
  @@index([organizationId, status])
  @@index([createdById])
  @@index([deletedAt])
  @@map("projects")
}

model ProjectMembership {
  id String @id @default(cuid())
  organizationId String
  membershipId String
  projectId String
  role ProjectRole
  grantedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  membership Membership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  project Project @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  grantedBy User? @relation("ProjectGrantActor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([membershipId, projectId])
  @@index([projectId, role])
  @@index([membershipId, organizationId])
  @@map("project_memberships")
}

model InvitationProjectGrant {
  id String @id @default(cuid())
  invitationId String
  organizationId String
  projectId String
  role ProjectRole
  createdAt DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  project Project @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([invitationId, projectId])
  @@index([projectId])
  @@map("invitation_project_grants")
}

// SPRINT
model Sprint {
  id        String       @id @default(cuid())
  name      String
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  status    SprintStatus @default(PLANNED)
  projectId String
  order     Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@index([status])
  @@index([projectId, status])
  @@map("sprints")
}

// TASK
model Task {
  id                String       @id @default(cuid())
  number            Int // Auto-incremented task number per project (e.g., PROJ-42)
  title             String
  description       String?
  priority          TaskPriority @default(MEDIUM)
  status            TaskStatus   @default(TODO)
  storyPoints       Int? // Agile story points estimation
  dueDate           DateTime?
  completedAt       DateTime?
  // 提醒去重标记：置位后同一轮提醒不会重复发送（改 dueDate 时重置）
  dueSoonNotifiedAt DateTime?
  overdueNotifiedAt DateTime?

  // Multi-tenant isolation fields
  organizationId String
  projectId      String
  sprintId       String? // Nullable: tasks can exist in backlog (no sprint)
  createdById    String?
  assignedToId   String?

  // Self-referencing for subtasks
  parentTaskId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint       Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  parentTask   Task?        @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subTasks     Task[]       @relation("SubTasks")

  comments     Comment[]
  attachments  Attachment[]
  labels       TaskLabel[]
  watchers     TaskWatcher[]
  activities   TaskActivity[]
  dependencies TaskDependency[] @relation("DependentTask")
  dependents   TaskDependency[] @relation("DependencyTask")

  @@unique([projectId, number])
  @@index([status])
  @@index([priority])
  @@index([projectId])
  @@index([organizationId])
  @@index([sprintId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([dueDate])
  @@index([deletedAt])
  @@index([organizationId, status])
  @@index([projectId, sprintId])
  @@index([projectId, status])
  @@map("tasks")
}

// TASK DEPENDENCY (Task blocks another Task)
model TaskDependency {
  id               String   @id @default(cuid())
  dependentTaskId  String // The task that is blocked
  dependencyTaskId String // The task that blocks it
  createdAt        DateTime @default(now())

  dependentTask  Task @relation("DependentTask", fields: [dependentTaskId], references: [id], onDelete: Cascade)
  dependencyTask Task @relation("DependencyTask", fields: [dependencyTaskId], references: [id], onDelete: Cascade)

  @@unique([dependentTaskId, dependencyTaskId])
  @@index([dependentTaskId])
  @@index([dependencyTaskId])
  @@map("task_dependencies")
}

// TASK WATCHER (Users watching a task for notifications)
model TaskWatcher {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@map("task_watchers")
}

// TASK ACTIVITY LOG (Timeline of all task events)
model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String?
  action    String // e.g. "changed status from TODO to IN_PROGRESS"
  field     String? // Which field changed
  oldValue  String?
  newValue  String?
  meta      Json?    @default("{}")
  createdAt DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([actorId])
  @@index([createdAt])
  @@map("task_activities")
}

// COMMENT
model Comment {
  id        String      @id @default(cuid())
  body      String
  type      CommentType @default(TEXT)
  taskId    String
  authorId  String?
  isEdited  Boolean     @default(false)
  deletedAt DateTime?

  // Self-referencing for threaded replies
  parentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  task    Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author  User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies Comment[] @relation("CommentReplies")

  @@index([taskId])
  @@index([authorId])
  @@index([parentId])
  @@index([deletedAt])
  @@map("comments")
}

// ATTACHMENT
model Attachment {
  id           String           @id @default(cuid())
  filename     String
  mimeType     String
  size         Int // bytes
  url          String
  fileKey      String? // Storage object key — used for object deletion
  storageProvider AttachmentStorageProvider @default(LOCAL)
  bucket       String?
  checksum     String?
  source       AttachmentSource @default(UPLOAD)
  visibility AttachmentVisibility @default(UNKNOWN)

  // At most one host may claim an attachment — a task, a ticket or a ticket
  // reply. General uploads land with all three empty until a business flow
  // claims them by fileKey.
  taskId        String?
  ticketId      String?
  ticketReplyId String?
  uploadedById  String?

  /// When a business flow persisted this object's URL without a task/ticket
  /// host — an avatar on a user, a logo on an organization, a brand image in
  /// settings. Those rows have no host column to point at them, so this
  /// timestamp is what keeps the orphan cleanup from deleting a live file.
  claimedAt DateTime?

  createdAt DateTime @default(now())

  task        Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  ticket      Ticket?      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketReply TicketReply? @relation(fields: [ticketReplyId], references: [id], onDelete: Cascade)
  uploadedBy  User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([ticketId])
  @@index([ticketReplyId])
  @@index([fileKey])
  @@map("attachments")
}

// SETTING
model Setting {
  key         String           @id
  name        String
  value       Json
  valueType   SettingValueType
  description String?
  isSecret    Boolean          @default(false)
  /// 是否被平台覆盖过。seed 写入的内置行是 false，管理端改过即为 true —— `isDefault` 由此判定
  overridden  Boolean          @default(false)
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isSecret])
  @@map("settings")
}

// LABEL
model Label {
  id             String  @id @default(cuid())
  name           String
  color          String // Hex color e.g. #FF5733
  organizationId String
  projectId      String? // Optional: org-wide labels have no projectId
  createdById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("LabelCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tasks        TaskLabel[]

  @@unique([name, organizationId, projectId])
  @@index([organizationId])
  @@index([projectId])
  @@map("labels")
}

// TASK LABEL (Pivot: Task <-> Label)
model TaskLabel {
  taskId    String
  labelId   String
  createdAt DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([taskId])
  @@index([labelId])
  @@map("task_labels")
}

// NOTIFICATION
model Notification {
  id           String           @id @default(cuid())
  userId       String
  organizationId String?
  projectId String?
  accessScope NotificationAccessScope @default(UNKNOWN)
  dedupKey     String?          @unique
  type         NotificationType
  title        String
  body         String?
  isRead       Boolean          @default(false)
  readAt       DateTime?
  // Generic resource pointer
  resourceType String? // e.g. "Task", "Comment", "Sprint"
  resourceId   String? // UUID of the related resource
  meta         Json?            @default("{}")

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, accessScope, projectId, isRead])
  @@index([createdAt])
  @@index([resourceType, resourceId])
  @@map("notifications")
}

// Transactional delivery intents; network delivery never runs in business transactions.
model NotificationDelivery {
  id          String    @id @default(cuid())
  dedupKey    String    @unique
  channel     String
  payload     Json
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  leaseUntil  DateTime?
  leaseToken  String?
  lastError   String?
  deliveredAt DateTime?
  dispatchAuthorizedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, availableAt])
  @@index([status, leaseUntil])
  @@map("notification_deliveries")
}

// AUDIT LOG (Immutable log of all important actions across the platform)
model AuditLog {
  id             String      @id @default(cuid())
  actorId        String?
  organizationId String?
  projectId      String?
  action         AuditAction
  entity         String // Model name: "Task", "Project", "Membership", etc.
  entityId       String // UUID of affected entity
  before         Json? // Snapshot before change
  after          Json? // Snapshot after change
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime    @default(now())

  actor        User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([organizationId])
  @@index([projectId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==================== MONITORING ====================

enum MonitorType {
  HTTP
  TCP
  PING
  DNS
  MYSQL
  POSTGRESQL
  REDIS
  MONGODB
  DOCKER
  GRPC
  WEBSOCKET
}

enum MonitorStatus {
  UNKNOWN
  UP
  DEGRADED
  DOWN
  PAUSED
}

enum ProbeScope {
  SYSTEM
  TENANT
}

enum ProbeProvider {
  TENCENT
  ALIYUN
  CUSTOM
}

enum ProbeStatus {
  ONLINE
  OFFLINE
}

enum CheckSource {
  LOCAL
  PROBE
}

enum ExecutionTrigger {
  SCHEDULED
  MANUAL
  CALLBACK
}

enum ExecutionStatus {
  SUCCESS
  FAILED
  TIMEOUT
  SKIPPED
}

enum NotificationChannelType {
  FEISHU
  WECOM
  DINGTALK
  WECHAT_SUBSCRIBE
  EMAIL
}

enum NotificationStatus {
  SUCCESS
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  /// 被更高等级的订阅压住：剩余天数冻结，等高端订阅结束后自动恢复。
  PAUSED
  EXPIRED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentChannel {
  WECHAT
  WECHAT_VIRTUAL
  ALIPAY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

/// 退款的来源与算法：客服解释「为什么退这么多」时按它对照政策。
enum RefundType {
  /// 未生效或冷静期内：全额
  FULL
  /// 超过冷静期：按未使用天数折算
  PRORATED
  /// 后台人工指定金额
  MANUAL
}

enum RefundStatus {
  /// 已申请，待审批或待提交渠道
  PENDING
  /// 已提交渠道，等终态（微信回调 / 支付宝轮询）
  PROCESSING
  SUCCESS
  FAILED
  /// 被拒或人工关闭
  CLOSED
}

// 监控目标
model Monitor {
  id                 String      @id @default(cuid())
  organizationId     String
  projectId          String
  name               String
  type               MonitorType
  target             String
  config             Json        @default("{}")
  credentialsEnc     String?
  configVersion      Int         @default(1)
  revision           Int         @default(1)
  interval           Int         @default(60)
  timeout            Int         @default(5000)
  expectedStatus     Int         @default(200)
  failureThreshold   Int         @default(3)
  /// 投票探针的成功比例门槛，1-100 的百分比：100 表示所有投票探针都必须成功。
  probeSuccessRatio  Int         @default(100)
  /// true 表示成功率判定只看租户探针：分配到的系统探针照常执行，但不进入分子/分母。
  tenantProbesOnly   Boolean     @default(false)
  checkSsl           Boolean     @default(false)
  sslExpiryThreshold Int         @default(30)
  enabled            Boolean     @default(true)
  /// Excluded from the retained quota slots. Execution stops at this instant;
  /// null means retained. Independent of the user's enabled flag.
  quotaGraceEndsAt   DateTime?
  configRevision     Int         @default(1)
  historyRevision    Int         @default(0)

  // 可用率告警（内嵌阈值告警）：最近 N 次检查可用率 < 阈值且连续失败达阈值时报警
  availabilityEnabled   Boolean @default(false)
  availabilityThreshold Float?  @default(90) // 可用率阈值 %，< 该值触发
  availabilityWindow    Int?    @default(10) // 统计窗口：最近 N 次检查

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  state        MonitorState?
  probes       MonitorProbe[]
  checkLogs    CheckLog[]
  executions   ProbeExecution[]
  // 该 monitor 绑定的通知渠道（多选）；为空时回退组织全部启用渠道
  notificationChannels MonitorNotificationChannel[]
  // 该 monitor 绑定的嵌套规则组（高级模式）
  ruleBindings MonitorRuleBinding[]

  @@index([organizationId])
  @@index([organizationId, quotaGraceEndsAt])
  @@index([projectId])
  @@index([enabled])
  @@index([projectId, enabled])
  @@index([deletedAt])
  @@map("monitors")
}

// 监控状态（独立存储，避免频繁更新主表）
model MonitorState {
  monitorId          String         @id @default(cuid())
  status             MonitorStatus  @default(UNKNOWN)
  failCount          Int            @default(0)
  lastCheckAt        DateTime?
  noDataSince        DateTime?
  lastEffectiveObservationAt DateTime?
  // 最近一次"本地检测"时间（探针回调不会推进它），调度到期判定只看这一列
  lastLocalCheckAt   DateTime?
  executionBlockedReason String?
  lastError          String?
  lastLatency        Int?
  lastNotifiedStatus MonitorStatus?
  sslExpiresAt       DateTime?
  sslDaysRemaining   Int?
  sslIssuer          String?
  sslSubject         String?
  sslLastNotifiedAt  DateTime?
  // 最近一次可用率告警的发送时间（信息用途）
  lastAvailabilityAlertAt DateTime?
  // 是否处于可用率告警状态：命中时置真并只告警一次，恢复时发恢复通知并置假
  availabilityAlertActive Boolean    @default(false)
  connectivityFailCount Int          @default(0)
  lastAppliedObservationAt DateTime?
  lastAppliedObservationId String?
  availabilityAlertPendingId String?
  updatedAt          DateTime       @updatedAt

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@map("monitor_states")
}

// monitor 与通知渠道的多对多绑定（可用率告警发送目标）
model MonitorNotificationChannel {
  monitorId String
  channelId String
  createdAt DateTime @default(now())

  monitor Monitor             @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  channel NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([monitorId, channelId])
  @@index([monitorId])
  @@index([channelId])
  @@map("monitor_notification_channels")
}

// ==================== 规则引擎（嵌套规则） ====================

// 规则组：一棵逻辑树（LogicNode | ConditionNode 的 JSON）
model RuleGroup {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String? // null = 组织级，非空 = 项目级
  name           String
  description    String?
  // 整棵逻辑树：LogicNode | ConditionNode 的 JSON
  tree           Json
  // 冗余：树里用到的字段名，便于按字段反查规则
  fieldsUsed     String[] @default([])
  enabled        Boolean  @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bindings     MonitorRuleBinding[]

  @@index([organizationId])
  @@index([projectId])
  @@index([enabled])
  @@index([deletedAt])
  @@map("rule_groups")
}

// monitor 与规则组的绑定
model MonitorRuleBinding {
  id          String  @id @default(cuid())
  monitorId   String
  ruleGroupId String
  // 同一个 monitor 绑定多个规则组时的优先级，数字越大越先求值
  priority    Int     @default(0)
  enabled     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  monitor   Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  ruleGroup RuleGroup @relation(fields: [ruleGroupId], references: [id], onDelete: Cascade)

  @@unique([monitorId, ruleGroupId])
  @@index([monitorId])
  @@index([ruleGroupId])
  @@map("monitor_rule_bindings")
}

// 探针
model Probe {
  id                       String        @id @default(cuid())
  scope                    ProbeScope    @default(TENANT)
  organizationId           String?
  name                     String
  provider                 ProbeProvider
  region                   String
  callbackUrl              String
  enabled                  Boolean       @default(true)
  lastHeartbeat            DateTime?
  // 探针最近一次上报的心跳周期（秒）；离线阈值按它的倍数推导，null = 未上报过
  heartbeatIntervalSeconds Int?
  status                   ProbeStatus   @default(OFFLINE)
  maxTenants               Int?          @default(0)
  priority                 Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  monitors     MonitorProbe[]
  results      ProbeResult[]
  executions   ProbeExecution[]
  secrets      ProbeSecret[]

  @@index([scope])
  @@index([organizationId])
  @@index([enabled])
  @@map("probes")
}

// 探针凭据：哈希存储（sha256），支持平滑轮换——同一探针在一次轮换期间
// 新旧 secret 并存，旧的在宽限期后由 expiresAt 自动失效。
model ProbeSecret {
  id           String    @id @default(cuid())
  probeId      String
  secretHash   String    @unique // sha256 hex of the raw secret
  secretPrefix String // e.g. tnt_1a2b3c4d — for display only
  // 宽限期截止：null = 不过期（当前有效）；轮换后的旧 secret 在此刻失效
  expiresAt    DateTime?
  revokedAt    DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  probe Probe @relation(fields: [probeId], references: [id], onDelete: Cascade)

  @@index([probeId])
  @@index([revokedAt])
  @@index([expiresAt])
  @@map("probe_secrets")
}

// 监控-探针多对多
model MonitorProbe {
  monitorId String
  probeId   String
  createdAt DateTime @default(now())

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  probe   Probe   @relation(fields: [probeId], references: [id], onDelete: Cascade)

  @@id([monitorId, probeId])
  @@index([monitorId])
  @@index([probeId])
  @@map("monitor_probes")
}

// 探针检测结果
model ProbeResult {
  id        String   @id @default(cuid())
  probeId   String
  probeRefId String?
  monitorId String?
  organizationId String?
  projectId String?
  monitorType MonitorType?
  configRevision Int?
  reportId String?
  payloadHash String?
  receivedAt DateTime @default(now())
  appliedAt DateTime?
  /// 该结果归属的批次标识；未归属到任何批次时保留 null。
  roundId   String?
  target    String
  success   Boolean
  error     String?
  // 探针观测到的实际 HTTP 状态码（可选）
  statusCode Int?
  latency   Int
  checkedAt DateTime @default(now())

  probe Probe? @relation(fields: [probeRefId], references: [id], onDelete: SetNull)

  @@unique([probeId, reportId])
  @@index([projectId, monitorId, checkedAt])
  @@index([projectId, probeId, checkedAt])
  @@index([target, checkedAt])
  @@index([probeId, checkedAt])
  @@index([checkedAt])
  @@index([monitorId, roundId, checkedAt])
  @@index([projectId, monitorId, roundId])
  @@map("probe_results")
}

// 探针和检测执行日志
model ProbeExecution {
  id           String           @id @default(cuid())
  probeId      String?
  monitorId    String?
  target       String
  trigger      ExecutionTrigger
  status       ExecutionStatus
  success      Boolean
  latency      Int?
  error        String?
  requestMeta  Json?            @default("{}")
  responseMeta Json?            @default("{}")
  executedAt   DateTime         @default(now())

  probe   Probe?   @relation(fields: [probeId], references: [id], onDelete: SetNull)
  monitor Monitor? @relation(fields: [monitorId], references: [id], onDelete: SetNull)

  @@index([probeId, executedAt])
  @@index([monitorId, executedAt])
  @@index([status])
  @@index([executedAt])
  @@map("probe_executions")
}

// 检测历史
model CheckLog {
  id             String      @id @default(cuid())
  monitorId      String
  monitorRefId   String?
  organizationId String?
  projectId      String?
  monitorType    MonitorType?
  observationId  String? @unique
  configRevision Int?
  serviceVerdict String?
  localServiceVerdict String?
  sslVerdict String?
  // 最终判定结论（本地结果与探针结果聚合后）
  success        Boolean
  // 本地探测的原始结果；探针回调写入时记录本地最近一次结果，本地检测时等于 success
  localSuccess   Boolean?
  // 本地失败但探针成功时置真，便于区分"探针救回"的判定
  rescuedByProbe Boolean     @default(false)
  latency        Int
  error          String?
  // 实际 HTTP 状态码（服务器有响应时），供规则与历史使用
  statusCode     Int?
  // 规则校验结论：本轮规则树是否命中（命中=异常）；无绑定规则组时回退为 !success
  ruleMatched    Boolean     @default(false)
  // 命中的规则组 ID，便于追溯「为什么触发」
  ruleGroupIds   String[]    @default([])
  source         CheckSource @default(LOCAL)
  revision       Int         @default(1)
  evaluated      Boolean     @default(true)
  failureKind    String?
  meta           Json        @default("{}")
  checkedAt      DateTime    @default(now())
  /// 批次标识：由一次本地检查锚定的一轮聚合；旧数据为 null。
  roundId        String?
  /// 批次结论已写入状态与告警的时间；null 表示该批次尚未结算。
  appliedAt      DateTime?

  monitor Monitor? @relation(fields: [monitorRefId], references: [id], onDelete: SetNull)

  @@unique([monitorId, roundId])
  @@index([projectId, source, checkedAt])
  @@index([projectId, source, monitorType, checkedAt])
  @@index([monitorId, checkedAt])
  @@index([monitorId, appliedAt])
  @@index([checkedAt])
  @@map("check_logs")
}

// 通知渠道配置
model NotificationChannel {
  id             String                  @id @default(cuid())
  organizationId String
  type           NotificationChannelType
  name           String
  config         Json                    @default("{}")
  enabled        Boolean                 @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  logs         NotificationLog[]
  monitors     MonitorNotificationChannel[]

  @@index([organizationId])
  @@index([enabled])
  @@map("notification_channels")
}

// 通知日志
model NotificationLog {
  id        String             @id @default(cuid())
  monitorId String
  channelId String
  channelRefId String?
  eventId String?
  deliveryId String?
  phase String?
  attempt Int?
  status    NotificationStatus
  error     String?
  sentAt    DateTime           @default(now())

  channel NotificationChannel? @relation(fields: [channelRefId], references: [id], onDelete: SetNull)

  @@index([monitorId, sentAt])
  @@index([channelId, sentAt])
  @@index([eventId, sentAt])
  @@map("notification_logs")
}

model MonitoringCoverage {
  projectId String @id
  checksStartedAt DateTime @default(now())
  countsStartedAt DateTime @default(now())
  probeStartedAt DateTime @default(now())
  alertsStartedAt DateTime @default(now())
  version Int @default(1)

  @@map("monitoring_coverage")
}

model MonitorHistory {
  id String @id @default(cuid())
  monitorId String
  organizationId String
  projectId String
  enabled Boolean
  deleted Boolean
  status MonitorStatus
  effectiveAt DateTime @default(now())
  revision Int
  cause String

  @@unique([monitorId, revision])
  @@index([projectId, effectiveAt])
  @@index([monitorId, effectiveAt, revision])
  @@map("monitor_history")
}

model AlertEvent {
  id String @id @default(cuid())
  monitorId String
  organizationId String
  projectId String
  monitorName String
  target String
  kind String
  level String
  status String @default("ongoing")
  suppressedReason String?
  reason String
  threshold Float?
  actual Float?
  unit String?
  message String?
  origin String @default("OBSERVED")
  latestEvidence Json @default("{}")
  lifecycleRevision Int @default(1)
  startedAt DateTime @default(now())
  resolvedAt DateTime?
  durationSeconds Int?
  firstNotifiedAt DateTime?
  updatedAt DateTime @updatedAt
  deliveries AlertDelivery[]

  @@index([projectId, updatedAt, id])
  @@index([projectId, status])
  @@map("alert_events")
}

model AlertDelivery {
  id String @id @default(cuid())
  eventId String
  eventRevision Int
  phase String
  channelId String
  payload Json
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  leaseToken String?
  deliveredAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  event AlertEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([eventId, eventRevision, phase, channelId])
  @@index([status, nextAttemptAt])
  @@index([status, createdAt, id])
  @@map("alert_deliveries")
}

// 状态页
model StatusPage {
  id                String   @id @default(cuid())
  organizationId    String
  slug              String   @unique
  title             String
  description       String?
  visibleMonitorIds String[] @default([])
  showLatency       Boolean  @default(true)
  showUptime        Boolean  @default(false)
  enabled           Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([slug])
  @@map("status_pages")
}

// ==================== DEVELOPER ACCESS ====================

// 组织级 API Key：程序化访问 Beacon 监控能力（明文只在创建时返回一次）
model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  keyPrefix      String // e.g. bk_org_1a2b3c4d — for display only
  keyHash        String    @unique // SHA-256 of the full key
  scopes         String[]  @default([])
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdById])
  @@index([revokedAt])
  @@map("api_keys")
}

// 用户级 Personal Access Token：可吊销的用户 JWT（claims 带 kind=pat + patId）
model PersonalAccessToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  tokenHash  String    @unique // SHA-256 of the raw token
  scopes     String[]  @default([])
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([revokedAt])
  @@map("personal_access_tokens")
}

// ==================== BILLING ====================

// 套餐定义
model Plan {
  id           String  @id @default(cuid())
  code         String  @unique
  name         String
  description  String?
  /// 最便宜「启用档位」价格（分）的镜像，真源是 PlanTerm.price。
  /// 由 AdminPlansService 在写档位时同步，不要单独改。
  price        Int     @default(0)
  /// 最便宜「启用档位」天数的镜像，真源是 PlanTerm.durationDays。
  /// 由 AdminPlansService 在写档位时同步，不要单独改。
  durationDays Int     @default(30)
  sortOrder    Int     @default(0)

  maxMonitors Int @default(5)
  maxProbes   Int @default(0)
  /// 每个监控自动分配的系统探针数量（按负载均衡从在线系统探针池里挑）；
  /// 0 表示不分配系统探针。与租户探针的绑定数量无关——租户探针只受 maxProbes 约束。
  maxProbesPerMonitor Int @default(0)
  maxApiKeys  Int @default(5)
  maxMembers  Int @default(3)
  maxChannels Int @default(1)
  minInterval Int @default(300)

  allowTenantProbe Boolean @default(false)
  allowStatusPage  Boolean @default(false)
  allowedMonitorTypes MonitorType[] @default([HTTP, TCP, PING])

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  orders        Order[]
  terms         PlanTerm[]

  @@index([code])
  @@map("plans")
}

/// 计费周期。时长以 PlanTerm.durationDays 为准（按 30/90/365 天近似）。
enum PlanCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

/// 套餐的计费周期档位：一个套餐可以同时卖月付 / 季付 / 年付，各自定价。
/// `(planId, cycle)` 唯一，因此一个周期在套餐内只有一个价格。
/// 停用（enabled = false）而不是删除，才能保住历史订单的引用。
model PlanTerm {
  id           String    @id @default(cuid())
  planId       String
  cycle        PlanCycle
  durationDays Int
  /// 该周期档位的价格（分）。
  price        Int
  /// 小程序虚拟支付道具 ID（MP 后台【虚拟支付 → 道具管理】发布到现网的道具）。
  /// 空 = 该档位尚未映射，不能用虚拟支付下单；道具单价必须与 `price` 一致。
  wechatProductId String?
  enabled      Boolean   @default(true)
  sortOrder    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan   Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([planId, cycle])
  @@index([planId, enabled, sortOrder])
  @@map("plan_terms")
}

// 订阅栈
model Subscription {
  id             String @id @default(cuid())
  organizationId String
  planId         String

  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime
  expiresAt DateTime
  autoRenew Boolean            @default(false)

  /// 进入 PAUSED 的时刻；恢复时清空。
  pausedAt DateTime?
  /// 冻结时结算的剩余天数。恢复时 `expiresAt = 恢复时刻 + pausedRemainingDays`。
  pausedRemainingDays Int?
  /// True only when every paid service interval is represented in the ledger.
  entitlementsTracked Boolean @default(false)

  orderId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])
  order        Order?       @relation(fields: [orderId], references: [id])
  entitlements SubscriptionEntitlement[]

  @@index([organizationId, status])
  @@index([expiresAt])
  @@map("subscriptions")
}

// 套餐降级监控数量宽限周期
model MonitorCapacityCycle {
  id                   String    @id @default(cuid())
  organizationId       String
  sourceKey            String    @unique
  sourceSubscriptionId String?
  purchaserId          String?
  fromPlanId           String
  fromLimit            Int
  toPlanId             String
  limit                Int
  startsAt             DateTime
  graceEndsAt          DateTime
  /// GRACE / LIMITED / RESOLVED. Closed rows are retained as tombstones.
  status               String    @default("GRACE")
  selectedMonitorIds   String[]  @default([])
  retainedMonitorIds   String[]  @default([])
  restrictedMonitorIds String[]  @default([])
  announcedAt          DateTime?
  warnedAt             DateTime?
  resolvedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([status, graceEndsAt])
  @@map("monitor_capacity_cycles")
}

// 订单
model Order {
  id             String @id @default(cuid())
  orderNo        String @unique
  organizationId String
  planId         String
  userId         String

  amount       Int
  currency     String @default("CNY")
  /// 下单时从所选档位（PlanTerm.durationDays）抄下来的快照。
  durationDays Int
  /// 下单所选周期档位的快照；引入档位之前的历史订单为空。
  cycle        PlanCycle?
  termId       String?

  status      OrderStatus @default(PENDING)
  paidAt      DateTime?
  cancelledAt DateTime?
  expiresAt   DateTime

  /// 本单覆盖的服务期快照（结算时写入）：退款按天折算与订阅回收都靠它定位
  /// 「这笔订单买到了哪段时间」。续费订单不会写 `Subscription.orderId`，
  /// 没有快照就查不出自己的时段；历史订单为空。
  serviceStartsAt DateTime?
  serviceEndsAt   DateTime?

  /// 累计已退金额（分）。一单一退（P0/P1），保留累加是为了对账与并发超退校验。
  refundedAmount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  plan         Plan          @relation(fields: [planId], references: [id])
  term         PlanTerm?     @relation(fields: [termId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  payment      Payment?
  paymentAttempts PaymentAttempt[]
  subscription Subscription?
  entitlement SubscriptionEntitlement?
  refunds      Refund[]

  @@index([organizationId])
  @@index([status])
  @@index([expiresAt])
  @@index([termId])
  @@map("orders")
}

// 支付记录
model Payment {
  id             String         @id @default(cuid())
  orderId        String         @unique
  channel        PaymentChannel
  /// 平台侧唯一单号：微信支付 V3 是 `transaction_id`，虚拟支付是 `wx_order_id`
  /// （发货推送里的 `WeChatPayInfo.MchOrderNo`）。幂等去重以此为准。
  transactionId  String?        @unique
  prepayId       String?
  /// 最终结算的商户支付尝试单号；历史记录为空时回退到 Order.orderNo。
  outTradeNo     String?
  amount         Int
  /// 累计已退金额（分），与 `Order.refundedAmount` 同步累加。
  refundedAmount Int            @default(0)
  status         PaymentStatus  @default(PENDING)
  paidAt         DateTime?
  rawCallback    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([transactionId])
  @@map("payments")
}

// 退款记录（一单一退：同一订单在途/成功的记录最多一条，见 §3.5）
// 独立成表的原因：`Payment.orderId` 是唯一键（一单一条支付记录），部分退款
// 与对账需要按次累积，不能挤在支付记录上。
model Refund {
  id             String         @id @default(cuid())
  /// 渠道幂等键：微信 `out_refund_no`、支付宝 `out_request_no`、虚拟支付 `MchOrderNo`
  refundNo       String         @unique
  orderId        String
  organizationId String
  channel        PaymentChannel

  type   RefundType
  status RefundStatus @default(PENDING)

  /// 申请退款金额（分）
  amount        Int
  /// 渠道实际退款金额（分），部分退款/手续费场景下可能小于 `amount`
  settledAmount Int?

  /// 政策快照：COOLING_OFF / NOT_STARTED / PRORATED / MANUAL
  policyCode    String?
  /// 折算快照（天），免去事后重算时因时间流逝得出不同结果
  usedDays      Int?
  remainingDays Int?

  reason          String?
  requestedBy     String?
  approvedBy      String?
  channelRefundId String?
  failureReason   String?
  rawResponse     Json?
  refundedAt      DateTime?
  /// First durable authorization to submit to the channel; null means never submitted.
  submittedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status, updatedAt])
  @@index([organizationId])
  @@map("refunds")
}

/// Live per-order service accounting, independent of immutable financial snapshots.
/// startsAt/endsAt delimit the remaining schedule; consumedMs survives pause/reorder.
model SubscriptionEntitlement {
  orderId        String @id
  subscriptionId String
  startsAt       DateTime
  endsAt         DateTime
  consumedMs     BigInt @default(0)

  order        Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, startsAt])
  @@map("subscription_entitlements")
}

// 支付尝试（每次「发起支付」一条）
// 微信虚拟支付要求 `outTradeNo` 每次下单重新生成、不可复用（复用报 -15002），
// 而 `Payment.orderId` 是唯一键（一单只能有一条结算记录）。把「下单尝试」
// 与「最终结算」拆开：用户重复点击支付会产生多条 attempt，旧单号成功回调
// 仍能按 `outTradeNo` 找回对应的订单，不会因为覆盖而丢货。
enum PaymentAttemptStatus {
  PENDING
  PAID
  CLOSED
  FAILED
}

model PaymentAttempt {
  id                  String               @id @default(cuid())
  orderId             String
  channel             PaymentChannel
  /// 商家业务单号：8-32 位、不以 `_` 开头、每次下单重新生成。
  outTradeNo          String               @unique
  /// 下单用的用户 openid（虚拟支付按 openid + 单号查单）。
  openid              String
  /// 虚拟支付道具 ID；V3 通道为空。
  productId           String?
  /// 金额（分），下单时从订单抄下来，回调用它核对实付金额。
  amount              Int
  /// 0 = 现网，1 = 沙箱。
  env                 Int                  @default(0)
  status              PaymentAttemptStatus @default(PENDING)
  /// 渠道交易号（虚拟支付 wx_order_id、V3 transaction_id、支付宝 trade_no），幂等键。
  wxOrderId           String?              @unique
  paidAt              DateTime?
  /// 回调原文（虚拟支付是 XML 字符串，包装成 `{ xml }`）。
  rawNotify           Json?
  prepayId            String?
  lastCheckedAt       DateTime?
  lastError           String?
  closePending        Boolean              @default(false)
  reconcileLeaseToken String?
  reconcileLeaseUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status, createdAt])
  @@index([channel, status, lastCheckedAt])
  @@map("payment_attempts")
}

// ── 平台工单（Support Ticket）─────────────────────────────────────────────
// 平台级资源：已登录用户向平台运营方（SUPER_ADMIN）提交问题，不属于任何 Project。

enum TicketStatus {
  OPEN
  PROCESSING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketAuthorType {
  USER
  STAFF
}

// 时间轴事件类型（回复不进本枚举，由 TicketReply 承载）
enum TicketActivityType {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  CATEGORY_CHANGED
  ASSIGNED
  UNASSIGNED
}

model Ticket {
  id             String         @id @default(cuid())
  number         Int            @unique
  subject        String
  content        String
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(MEDIUM)
  categoryId     String?

  authorId       String
  organizationId String?
  assigneeId     String?

  firstRespondedAt DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  author       User            @relation("TicketAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  assignee     User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  category     TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  replies      TicketReply[]
  activities   TicketActivity[]
  attachments  Attachment[]

  @@index([authorId, createdAt])
  @@index([status, createdAt])
  @@index([priority])
  @@index([categoryId])
  @@index([assigneeId])
  @@index([deletedAt])
  @@map("tickets")
}

// 回复（用户帖 / 平台帖 / 平台内部备注共用一张表）
model TicketReply {
  id             String           @id @default(cuid())
  ticketId       String
  authorId       String
  authorType     TicketAuthorType
  body           String
  isInternalNote Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation("TicketReplyAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  attachments Attachment[]

  @@index([ticketId, createdAt])
  @@index([authorId])
  @@map("ticket_replies")
}

// 时间轴事件（只记"动作"，不记回复正文）
model TicketActivity {
  id        String             @id @default(cuid())
  ticketId  String
  actorId   String?
  actorType TicketAuthorType
  type      TicketActivityType
  field     String?
  oldValue  String?
  newValue  String?
  meta      Json               @default("{}")
  createdAt DateTime           @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation("TicketActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([actorId])
  @@map("ticket_activities")
}

// 分类（平台级字典，全局共享）
model TicketCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets Ticket[]

  @@index([isActive, sortOrder])
  @@map("ticket_categories")
}
