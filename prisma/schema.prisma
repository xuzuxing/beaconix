generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ENUMS
enum GlobalRole {
  SUPER_ADMIN
  USER
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_COMMENTED
  TASK_STATUS_CHANGED
  TASK_DUE_SOON
  TASK_OVERDUE
  SPRINT_STARTED
  SPRINT_COMPLETED
  PROJECT_ARCHIVED
  MEMBER_JOINED
  MEMBER_REMOVED
  MENTION
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  ARCHIVE
  INVITE
  JOIN
  LEAVE
  ASSIGN
  UNASSIGN
}

enum AttachmentSource {
  UPLOAD
  GOOGLE_DRIVE
  DROPBOX
  URL
}

enum CommentType {
  TEXT
  SYSTEM
}

// OTP PURPOSE
enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// USER
model User {
  id            String     @id @default(cuid())
  email         String     @unique
  password      String
  name          String
  avatarUrl     String?
  globalRole    GlobalRole @default(USER)
  isActive      Boolean    @default(true)
  emailVerified Boolean    @default(false)
  lastSeenAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  ownedOrganizations Organization[] @relation("OrganizationOwner")
  memberships        Membership[]
  createdProjects    Project[]      @relation("ProjectCreator")
  createdTasks       Task[]         @relation("TaskCreator")
  assignedTasks      Task[]         @relation("TaskAssignee")
  comments           Comment[]
  notifications      Notification[]
  sentInvitations    Invitation[]   @relation("InvitationSender")
  auditLogs          AuditLog[]     @relation("AuditActor")
  taskWatchers       TaskWatcher[]
  taskActivities     TaskActivity[] @relation("ActivityActor")
  createdLabels      Label[]        @relation("LabelCreator")
  attachments        Attachment[]
  refreshTokens      RefreshToken[]
  otpCodes           OtpCode[]
  orders             Order[]

  @@index([createdAt])
  @@index([isActive])
  @@index([globalRole])
  @@map("users")
}

// OTP CODE (For email verification and password reset)
model OtpCode {
  id        String     @id @default(cuid())
  userId    String
  codeHash  String // bcrypt-hashed OTP
  purpose   OtpPurpose
  expiresAt DateTime
  usedAt    DateTime? // null = not yet used
  attempts  Int        @default(0) // track failed verification attempts
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

// REFRESH TOKEN (For stateless JWT authentication with refresh tokens)
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique // hashed refresh token
  expiresAt DateTime
  revokedAt DateTime? // null = still valid
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ORGANIZATION
model Organization {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  logoUrl     String?
  website     String?
  ownerId     String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Settings stored as JSON for flexibility
  settings Json? @default("{}")

  // Relations
  owner       User         @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  memberships Membership[]
  projects    Project[]
  invitations Invitation[]
  labels      Label[]
  auditLogs   AuditLog[]
  tasks       Task[]

  // Monitors
  monitors     Monitor[]
  probes       Probe[]
  channels     NotificationChannel[]
  statusPages  StatusPage[]
  subscriptions Subscription[]
  orders       Order[]

  @@index([ownerId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("organizations")
}

// MEMBERSHIP (Pivot: User <-> Organization)
model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(MEMBER)
  joinedAt       DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Tracks who invited this member
  invitedById String?

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([role])
  @@map("memberships")
}

// INVITATION
model Invitation {
  id             String           @id @default(cuid())
  email          String
  organizationId String
  role           MembershipRole   @default(MEMBER)
  status         InvitationStatus @default(PENDING)
  token          String           @unique @default(uuid())
  expiresAt      DateTime
  sentById       String
  acceptedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sentBy       User         @relation("InvitationSender", fields: [sentById], references: [id], onDelete: Cascade)

  @@unique([email, organizationId])
  @@index([organizationId])
  @@index([status])
  @@index([expiresAt])
  @@map("invitations")
}

// PROJECT
model Project {
  id             String        @id @default(cuid())
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  key            String // Short code e.g. "PROJ" used in task identifiers like PROJ-42
  organizationId String
  createdById    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  sprints      Sprint[]
  tasks        Task[]
  labels       Label[]
  auditLogs    AuditLog[]
  monitors     Monitor[]

  // Enforce unique project key per organization (e.g. no two "PROJ" in same org)
  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([status])
  @@index([organizationId, status])
  @@index([createdById])
  @@index([deletedAt])
  @@map("projects")
}

// SPRINT
model Sprint {
  id        String       @id @default(cuid())
  name      String
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  status    SprintStatus @default(PLANNED)
  projectId String
  order     Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@index([status])
  @@index([projectId, status])
  @@map("sprints")
}

// TASK
model Task {
  id          String       @id @default(cuid())
  number      Int // Auto-incremented task number per project (e.g., PROJ-42)
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  storyPoints Int? // Agile story points estimation
  dueDate     DateTime?
  completedAt DateTime?

  // Multi-tenant isolation fields
  organizationId String
  projectId      String
  sprintId       String? // Nullable: tasks can exist in backlog (no sprint)
  createdById    String?
  assignedToId   String?

  // Self-referencing for subtasks
  parentTaskId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint       Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  parentTask   Task?        @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subTasks     Task[]       @relation("SubTasks")

  comments     Comment[]
  attachments  Attachment[]
  labels       TaskLabel[]
  watchers     TaskWatcher[]
  activities   TaskActivity[]
  dependencies TaskDependency[] @relation("DependentTask")
  dependents   TaskDependency[] @relation("DependencyTask")

  @@unique([projectId, number])
  @@index([status])
  @@index([priority])
  @@index([projectId])
  @@index([organizationId])
  @@index([sprintId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([dueDate])
  @@index([deletedAt])
  @@index([organizationId, status])
  @@index([projectId, sprintId])
  @@index([projectId, status])
  @@map("tasks")
}

// TASK DEPENDENCY (Task blocks another Task)
model TaskDependency {
  id               String   @id @default(cuid())
  dependentTaskId  String // The task that is blocked
  dependencyTaskId String // The task that blocks it
  createdAt        DateTime @default(now())

  dependentTask  Task @relation("DependentTask", fields: [dependentTaskId], references: [id], onDelete: Cascade)
  dependencyTask Task @relation("DependencyTask", fields: [dependencyTaskId], references: [id], onDelete: Cascade)

  @@unique([dependentTaskId, dependencyTaskId])
  @@index([dependentTaskId])
  @@index([dependencyTaskId])
  @@map("task_dependencies")
}

// TASK WATCHER (Users watching a task for notifications)
model TaskWatcher {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@map("task_watchers")
}

// TASK ACTIVITY LOG (Timeline of all task events)
model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String?
  action    String // e.g. "changed status from TODO to IN_PROGRESS"
  field     String? // Which field changed
  oldValue  String?
  newValue  String?
  meta      Json?    @default("{}")
  createdAt DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([actorId])
  @@index([createdAt])
  @@map("task_activities")
}

// COMMENT
model Comment {
  id        String      @id @default(cuid())
  body      String
  type      CommentType @default(TEXT)
  taskId    String
  authorId  String?
  isEdited  Boolean     @default(false)
  deletedAt DateTime?

  // Self-referencing for threaded replies
  parentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  task    Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author  User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies Comment[] @relation("CommentReplies")

  @@index([taskId])
  @@index([authorId])
  @@index([parentId])
  @@index([deletedAt])
  @@map("comments")
}

// ATTACHMENT
model Attachment {
  id           String           @id @default(cuid())
  filename     String
  mimeType     String
  size         Int // bytes
  url          String
  fileKey      String? // UploadThing file key — used for CDN deletion
  source       AttachmentSource @default(UPLOAD)
  taskId       String
  uploadedById String?

  createdAt DateTime @default(now())

  task       Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@map("attachments")
}

// LABEL
model Label {
  id             String  @id @default(cuid())
  name           String
  color          String // Hex color e.g. #FF5733
  organizationId String
  projectId      String? // Optional: org-wide labels have no projectId
  createdById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("LabelCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tasks        TaskLabel[]

  @@unique([name, organizationId, projectId])
  @@index([organizationId])
  @@index([projectId])
  @@map("labels")
}

// TASK LABEL (Pivot: Task <-> Label)
model TaskLabel {
  taskId    String
  labelId   String
  createdAt DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([taskId])
  @@index([labelId])
  @@map("task_labels")
}

// NOTIFICATION
model Notification {
  id           String           @id @default(cuid())
  userId       String
  type         NotificationType
  title        String
  body         String?
  isRead       Boolean          @default(false)
  readAt       DateTime?
  // Generic resource pointer
  resourceType String? // e.g. "Task", "Comment", "Sprint"
  resourceId   String? // UUID of the related resource
  meta         Json?            @default("{}")

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@index([resourceType, resourceId])
  @@map("notifications")
}

// AUDIT LOG (Immutable log of all important actions across the platform)
model AuditLog {
  id             String      @id @default(cuid())
  actorId        String?
  organizationId String?
  projectId      String?
  action         AuditAction
  entity         String // Model name: "Task", "Project", "Membership", etc.
  entityId       String // UUID of affected entity
  before         Json? // Snapshot before change
  after          Json? // Snapshot after change
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime    @default(now())

  actor        User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([organizationId])
  @@index([projectId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==================== MONITORING ====================

enum MonitorType {
  HTTP
  TCP
}

enum MonitorStatus {
  UNKNOWN
  UP
  DEGRADED
  DOWN
  PAUSED
}

enum ProbeScope {
  SYSTEM
  TENANT
}

enum ProbeProvider {
  TENCENT
  ALIYUN
  CUSTOM
}

enum ProbeStatus {
  ONLINE
  OFFLINE
}

enum CheckSource {
  LOCAL
  PROBE
}

enum ExecutionTrigger {
  SCHEDULED
  MANUAL
  CALLBACK
}

enum ExecutionStatus {
  SUCCESS
  FAILED
  TIMEOUT
  SKIPPED
}

enum NotificationChannelType {
  FEISHU
  WECOM
  DINGTALK
  WECHAT_SUBSCRIBE
  EMAIL
}

enum NotificationStatus {
  SUCCESS
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentChannel {
  WECHAT
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// 监控目标
model Monitor {
  id                  String      @id @default(cuid())
  organizationId      String
  projectId           String
  name                String
  type                MonitorType
  target              String
  interval            Int         @default(60)
  timeout             Int         @default(5000)
  expectedStatus      Int         @default(200)
  failureThreshold    Int         @default(3)
  checkSsl            Boolean      @default(false)
  sslExpiryThreshold  Int  @default(30)
  enabled             Boolean     @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  state        MonitorState?
  probes       MonitorProbe[]
  checkLogs    CheckLog[]
  executions   ProbeExecution[]

  @@index([organizationId])
  @@index([projectId])
  @@index([enabled])
  @@index([projectId, enabled])
  @@index([deletedAt])
  @@map("monitors")
}

// 监控状态（独立存储，避免频繁更新主表）
model MonitorState {
  monitorId          String        @id @default(cuid())
  status             MonitorStatus @default(UNKNOWN)
  failCount          Int           @default(0)
  lastCheckAt        DateTime?
  lastError          String?
  lastLatency        Int?
  lastNotifiedStatus MonitorStatus?
  sslExpiresAt       DateTime?
  sslDaysRemaining   Int?
  sslIssuer          String?
  sslSubject         String?
  sslLastNotifiedAt  DateTime?
  updatedAt          DateTime      @updatedAt

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@map("monitor_states")
}

// 探针
model Probe {
  id             String        @id @default(cuid())
  scope          ProbeScope    @default(TENANT)
  organizationId String?
  name           String
  provider       ProbeProvider
  region         String
  callbackUrl    String
  secret         String        @unique
  enabled        Boolean       @default(true)
  lastHeartbeat  DateTime?
  status         ProbeStatus   @default(OFFLINE)
  maxTenants     Int?          @default(0)
  priority       Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  monitors     MonitorProbe[]
  results      ProbeResult[]
  executions   ProbeExecution[]

  @@index([scope])
  @@index([organizationId])
  @@index([enabled])
  @@map("probes")
}

// 监控-探针多对多
model MonitorProbe {
  monitorId String
  probeId   String
  createdAt DateTime @default(now())

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  probe   Probe   @relation(fields: [probeId], references: [id], onDelete: Cascade)

  @@id([monitorId, probeId])
  @@index([monitorId])
  @@index([probeId])
  @@map("monitor_probes")
}

// 探针检测结果
model ProbeResult {
  id        String   @id @default(cuid())
  probeId   String
  target    String
  success   Boolean
  error     String?
  latency   Int
  checkedAt DateTime @default(now())

  probe Probe @relation(fields: [probeId], references: [id], onDelete: Cascade)

  @@index([target, checkedAt])
  @@index([probeId, checkedAt])
  @@map("probe_results")
}

// 探针和检测执行日志
model ProbeExecution {
  id           String            @id @default(cuid())
  probeId      String?
  monitorId    String?
  target       String
  trigger      ExecutionTrigger
  status       ExecutionStatus
  success      Boolean
  latency      Int?
  error        String?
  requestMeta  Json?             @default("{}")
  responseMeta Json?             @default("{}")
  executedAt   DateTime          @default(now())

  probe   Probe?   @relation(fields: [probeId], references: [id], onDelete: SetNull)
  monitor Monitor? @relation(fields: [monitorId], references: [id], onDelete: SetNull)

  @@index([probeId, executedAt])
  @@index([monitorId, executedAt])
  @@index([status])
  @@map("probe_executions")
}

// 检测历史
model CheckLog {
  id        String   @id @default(cuid())
  monitorId String
  success   Boolean
  latency   Int
  error     String?
  source    CheckSource @default(LOCAL)
  checkedAt DateTime @default(now())

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt])
  @@map("check_logs")
}

// 通知渠道配置
model NotificationChannel {
  id             String                  @id @default(cuid())
  organizationId String
  type           NotificationChannelType
  name           String
  config         Json                    @default("{}")
  enabled        Boolean                 @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  logs         NotificationLog[]

  @@index([organizationId])
  @@index([enabled])
  @@map("notification_channels")
}

// 通知日志
model NotificationLog {
  id           String             @id @default(cuid())
  monitorId    String
  channelId    String
  status       NotificationStatus
  error        String?
  sentAt       DateTime           @default(now())

  channel NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([monitorId, sentAt])
  @@index([channelId, sentAt])
  @@map("notification_logs")
}

// 状态页
model StatusPage {
  id                String   @id @default(cuid())
  organizationId    String
  slug              String   @unique
  title             String
  description       String?
  visibleMonitorIds String[] @default([])
  showLatency       Boolean  @default(true)
  showUptime        Boolean  @default(false)
  enabled           Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([slug])
  @@map("status_pages")
}

// ==================== BILLING ====================

// 套餐定义
model Plan {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  price       Int     @default(0)
  durationDays Int    @default(30)
  sortOrder   Int     @default(0)

  maxMonitors Int @default(5)
  maxProbes   Int @default(0)
  maxMembers  Int @default(3)
  maxChannels Int @default(1)
  minInterval Int @default(300)

  allowTenantProbe Boolean @default(false)
  allowStatusPage  Boolean @default(false)

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  orders        Order[]

  @@index([code])
  @@map("plans")
}

// 订阅栈
model Subscription {
  id             String             @id @default(uuid())
  organizationId String
  planId         String

  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime
  expiresAt DateTime
  autoRenew Boolean            @default(false)

  orderId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])
  order        Order?       @relation(fields: [orderId], references: [id])

  @@index([organizationId, status])
  @@index([expiresAt])
  @@map("subscriptions")
}

// 订单
model Order {
  id             String      @id @default(uuid())
  orderNo        String      @unique
  organizationId String
  planId         String
  userId         String

  amount       Int
  currency     String       @default("CNY")
  durationDays Int

  status      OrderStatus @default(PENDING)
  paidAt      DateTime?
  cancelledAt DateTime?
  expiresAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  plan         Plan         @relation(fields: [planId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  payment      Payment?
  subscription Subscription?

  @@index([organizationId])
  @@index([status])
  @@index([expiresAt])
  @@map("orders")
}

// 支付记录
model Payment {
  id            String        @id @default(uuid())
  orderId       String        @unique
  channel       PaymentChannel
  transactionId String?       @unique
  prepayId      String?
  amount        Int
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  rawCallback   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([transactionId])
  @@map("payments")
}
