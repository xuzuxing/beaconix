enum RumAppPlatform {
  WEB
}

enum RumErrorCategory {
  JAVASCRIPT
  PROMISE
  RESOURCE
  HTTP
  VUE
  MANUAL
}

enum RumErrorLevel {
  INFO
  WARNING
  ERROR
  FATAL
}

enum RumErrorStatus {
  UNRESOLVED
  RESOLVED
  IGNORED
}

enum RumMetricKind {
  ERROR
  EVENT
}

enum RumAlertMetric {
  ERROR_COUNT
  EVENT_COUNT
  NEW_ERROR
  ERROR_RATE
  SPIKE
}

enum RumAlertScope {
  APP
  ERROR_GROUP
}

enum RumPerfMetric {
  LCP
  CLS
  INP
  FCP
  TTFB
  PAGE_LOAD
  RESOURCE
  HTTP
}

enum RumPerfRating {
  GOOD
  NEEDS_IMPROVEMENT
  POOR
}

enum RumMaintenanceJobType {
  PURGE
  SUBJECT_DELETION
}

enum RumMaintenanceJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum RumAlertIncidentStatus {
  OPEN
  RESOLVED
}

model RumApp {
  id             String         @id @default(cuid())
  organizationId String
  projectId      String
  name           String
  platform       RumAppPlatform @default(WEB)
  publicKey      String         @unique
  keyRotatedAt   DateTime?
  enabled        Boolean        @default(true)
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project         @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdBy    User?           @relation("RumAppCreator", fields: [createdById], references: [id], onDelete: SetNull)
  errorGroups  RumErrorGroup[]
  errorOccurrences RumErrorOccurrence[]
  events       RumEvent[]
  metricBuckets RumMetricBucket[]
  replaySessions RumReplaySession[]
  sourceMaps   RumSourceMap[]
  alertRules   RumAlertRule[]
  alertIncidents RumAlertIncident[]
  perfSamples  RumPerfSample[]
  perfBuckets  RumPerfBucket[]
  maintenanceJobs RumMaintenanceJob[]

  @@index([organizationId])
  @@index([projectId, deletedAt])
  @@index([projectId, enabled])
  @@index([createdById])
  @@map("rum_apps")
}

model RumErrorGroup {
  id                 String    @id @default(cuid())
  appId              String
  fingerprint        String
  fingerprintVersion Int       @default(1)
  type               String
  category           RumErrorCategory?
  level              RumErrorLevel?
  message            String
  stack              String?
  resolvedStack      String?
  page               String?
  release            String?
  replaySessionId    String?
  sourceMapApplied   Boolean   @default(false)
  count              Int       @default(1)
  status             RumErrorStatus @default(UNRESOLVED)
  ignoredUntil       DateTime?
  assigneeId         String?
  resolvedAt         DateTime?
  resolvedBy         String?
  reopenedAt         DateTime?
  firstSeenAt        DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())
  firstOccurredAt    DateTime?
  lastOccurredAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  app        RumApp         @relation(fields: [appId], references: [id], onDelete: Cascade)
  assignee   User?          @relation("RumErrorAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  resolver   User?          @relation("RumErrorResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)
  occurrences RumErrorOccurrence[]
  notes      RumErrorNote[]
  alertRules RumAlertRule[]

  @@unique([appId, fingerprintVersion, fingerprint])
  @@index([appId, lastSeenAt])
  @@index([appId, count])
  @@index([appId, release])
  @@index([appId, status, lastSeenAt])
  @@index([assigneeId])
  @@index([resolvedBy])
  @@map("rum_error_groups")
}

model RumErrorNote {
  id        String   @id @default(cuid())
  appId     String
  groupId   String
  authorId  String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group  RumErrorGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
  @@index([authorId])
  @@map("rum_error_notes")
}

model RumErrorOccurrence {
  id                 String           @id @default(cuid())
  appId              String
  groupId            String
  clientEventId      String?
  category           RumErrorCategory
  level              RumErrorLevel
  type               String
  message            String
  stack              String?
  resolvedStack      String?
  sourceMapApplied   Boolean          @default(false)
  page               String?
  release            String?
  sessionId          String?
  endUserId          String?
  anonymousId        String?
  requestId          String?
  http               Json?
  resource           Json?
  vue                Json?
  breadcrumbs        Json             @default("[]")
  sdk                Json?
  occurredAt         DateTime?
  receivedAt         DateTime         @default(now())

  app   RumApp        @relation(fields: [appId], references: [id], onDelete: Cascade)
  group RumErrorGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([appId, clientEventId])
  @@index([groupId, receivedAt])
  @@index([appId, receivedAt])
  @@index([appId, category, receivedAt])
  @@index([appId, requestId])
  @@map("rum_error_occurrences")
}

model RumEvent {
  id          String   @id @default(cuid())
  appId       String
  eventName   String
  endUserId   String?
  anonymousId String?
  sessionId   String?
  release     String?
  page        String?
  properties  Json     @default("{}")
  occurredAt  DateTime?
  receivedAt  DateTime @default(now())

  app RumApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, receivedAt])
  @@index([appId, eventName, receivedAt])
  @@index([appId, sessionId])
  @@map("rum_events")
}

model RumMetricBucket {
  id          String        @id @default(cuid())
  appId       String
  kind        RumMetricKind
  name        String
  bucketStart DateTime
  count       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  app RumApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, kind, name, bucketStart])
  @@index([appId, kind, bucketStart])
  @@map("rum_metric_buckets")
}

model RumReplaySession {
  id          String   @id @default(cuid())
  appId       String
  sessionKey  String
  release     String?
  page        String?
  startedAt   DateTime
  lastSeenAt  DateTime
  chunkCount  Int      @default(0)
  eventCount  Int      @default(0)
  sizeBytes   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  app    RumApp           @relation(fields: [appId], references: [id], onDelete: Cascade)
  chunks RumReplayChunk[]

  @@unique([appId, sessionKey])
  @@index([appId, lastSeenAt])
  @@map("rum_replay_sessions")
}

model RumReplayChunk {
  id          String   @id @default(cuid())
  sessionId   String
  sequence    Int
  events      Json
  eventCount  Int
  sizeBytes   Int
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  session RumReplaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
  @@index([sessionId, sequence])
  @@map("rum_replay_chunks")
}

model RumSourceMap {
  id           String   @id @default(cuid())
  appId        String
  release      String
  artifactPath String
  content      String
  checksum     String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  app        RumApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  uploadedBy User?  @relation("RumSourceMapUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([appId, release, artifactPath])
  @@index([appId, release])
  @@index([uploadedById])
  @@map("rum_source_maps")
}

model RumAlertRule {
  id            String         @id @default(cuid())
  appId         String
  name          String
  metric        RumAlertMetric
  scope         RumAlertScope  @default(APP)
  groupId       String?
  eventName     String?
  threshold     Int
  windowMinutes Int
  confirmWindows Int           @default(1)
  consecutiveHits Int          @default(0)
  silenceUntil  DateTime?
  channelIds    String[]       @default([])
  enabled       Boolean        @default(true)
  active        Boolean        @default(false)
  lastValue     Int            @default(0)
  lastEvaluatedAt DateTime?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  app       RumApp             @relation(fields: [appId], references: [id], onDelete: Cascade)
  errorGroup RumErrorGroup?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User?              @relation("RumAlertRuleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  incidents RumAlertIncident[]

  @@index([appId, deletedAt])
  @@index([enabled, deletedAt, metric])
  @@index([groupId])
  @@index([createdById])
  @@map("rum_alert_rules")
}

model RumAlertIncident {
  id                 String                 @id @default(cuid())
  ruleId             String
  appId              String
  status             RumAlertIncidentStatus @default(OPEN)
  value              Int
  threshold          Int
  startedAt          DateTime               @default(now())
  resolvedAt         DateTime?
  openedNotifiedAt   DateTime?
  resolvedNotifiedAt DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  rule RumAlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  app  RumApp       @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([ruleId, status])
  @@index([appId, startedAt])
  @@map("rum_alert_incidents")
}

model RumPerfSample {
  id          String        @id @default(cuid())
  appId       String
  metric      RumPerfMetric
  value       Float
  rating      RumPerfRating?
  page        String?
  release     String?
  dimension   String?
  success     Boolean       @default(true)
  sessionId   String?
  endUserId   String?
  occurredAt  DateTime?
  receivedAt  DateTime      @default(now())

  app RumApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, metric, receivedAt])
  @@index([appId, page, receivedAt])
  @@index([appId, dimension, receivedAt])
  @@map("rum_perf_samples")
}

model RumPerfBucket {
  id                  String        @id @default(cuid())
  appId               String
  metric              RumPerfMetric
  page                String        @default("*")
  dimension           String        @default("*")
  release             String        @default("*")
  bucketStart         DateTime
  count               Int           @default(0)
  sum                 Float         @default(0)
  failureCount        Int           @default(0)
  goodCount           Int           @default(0)
  needsImprovementCount Int         @default(0)
  poorCount           Int           @default(0)
  histogram           Json          @default("{}")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  app RumApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, metric, page, dimension, release, bucketStart])
  @@index([appId, metric, release, bucketStart])
  @@index([appId, page, bucketStart])
  @@map("rum_perf_buckets")
}

model RumMaintenanceJob {
  id             String                  @id @default(cuid())
  appId          String
  organizationId String
  type           RumMaintenanceJobType
  status         RumMaintenanceJobStatus @default(PENDING)
  payload        Json?
  result         Json?
  error          String?
  requestedById  String?
  createdAt      DateTime                @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  updatedAt      DateTime                @updatedAt

  app         RumApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  requestedBy User?  @relation("RumMaintenanceRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([appId, createdAt])
  @@index([status, createdAt])
  @@index([requestedById])
  @@map("rum_maintenance_jobs")
}
