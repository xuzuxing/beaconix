// ENUMS
enum GlobalRole {
  SUPER_ADMIN
  USER
}

// OTP PURPOSE
enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// USER
model User {
  id            String     @id @default(cuid())
  email         String     @unique
  password      String
  name          String
  avatarUrl     String?
  globalRole    GlobalRole @default(USER)
  platformAuthorityVersion Int @default(0)
  isActive      Boolean    @default(true)
  emailVerified Boolean    @default(false)
  lastSeenAt    DateTime?

  // Two-factor authentication (TOTP). `twoFactorEnabled` is the fast path the
  // login flow checks; the secret itself lives in TwoFactorSecret.
  twoFactorEnabled   Boolean   @default(false)
  twoFactorEnabledAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  identities           UserIdentity[]
  ownedOrganizations   Organization[]        @relation("OrganizationOwner")
  memberships          Membership[]
  grantedProjectMemberships ProjectMembership[] @relation("ProjectGrantActor")
  createdProjects      Project[]             @relation("ProjectCreator")
  createdRumApps       RumApp[]              @relation("RumAppCreator")
  uploadedRumSourceMaps RumSourceMap[]        @relation("RumSourceMapUploader")
  createdRumAlertRules RumAlertRule[]         @relation("RumAlertRuleCreator")
  createdTasks         Task[]                @relation("TaskCreator")
  assignedTasks        Task[]                @relation("TaskAssignee")
  comments             Comment[]
  notifications        Notification[]
  sentInvitations      Invitation[]          @relation("InvitationSender")
  auditLogs            AuditLog[]            @relation("AuditActor")
  taskWatchers         TaskWatcher[]
  taskActivities       TaskActivity[]        @relation("ActivityActor")
  createdLabels        Label[]               @relation("LabelCreator")
  attachments          Attachment[]
  refreshTokens        RefreshToken[]
  otpCodes             OtpCode[]
  orders               Order[]
  apiKeys              ApiKey[]              @relation("ApiKeyCreator")
  personalAccessTokens PersonalAccessToken[]
  twoFactorSecret        TwoFactorSecret?
  twoFactorRecoveryCodes TwoFactorRecoveryCode[]
  twoFactorChallenges    TwoFactorChallenge[]

  // Platform support tickets
  tickets          Ticket[]         @relation("TicketAuthor")
  assignedTickets  Ticket[]         @relation("TicketAssignee")
  ticketReplies    TicketReply[]    @relation("TicketReplyAuthor")
  ticketActivities TicketActivity[] @relation("TicketActivityActor")

  @@index([createdAt])
  @@index([isActive])
  @@index([globalRole])
  @@map("users")
}

// IDENTITY PROVIDER
enum IdentityProvider {
  WECHAT_WEB
  WECHAT_MINI
}

// USER IDENTITY (third-party login accounts bound to a Beacon user)
model UserIdentity {
  id        String           @id @default(cuid())
  userId    String
  provider  IdentityProvider
  openid    String
  unionid   String?
  nickname  String?
  avatarUrl String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, openid])
  @@index([userId])
  @@index([unionid])
  @@map("user_identities")
}

// OTP CODE (For email verification and password reset)
model OtpCode {
  id        String     @id @default(cuid())
  userId    String
  codeHash  String // bcrypt-hashed OTP
  purpose   OtpPurpose
  expiresAt DateTime
  usedAt    DateTime? // null = not yet used
  attempts  Int        @default(0) // track failed verification attempts
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

// REFRESH TOKEN (For stateless JWT authentication with refresh tokens)
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique // hashed refresh token
  expiresAt DateTime
  revokedAt DateTime? // null = still valid
  /// Rotation family; legacy tokens are assigned a family on their first rotation.
  familyId  String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// TWO FACTOR AUTHENTICATION (user-level TOTP second factor)

// The encrypted TOTP shared secret for a user that has 2FA enabled.
model TwoFactorSecret {
  id        String   @id @default(cuid())
  userId    String   @unique
  secretEnc String // AES-256-GCM ciphertext, format: v1:<iv>:<tag>:<ciphertext>
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_secrets")
}

// One-shot recovery codes. Only the bcrypt hash is stored; a code is consumed
// by setting usedAt so it can never be replayed.
model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String // bcrypt hash of the plaintext recovery code
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("two_factor_recovery_codes")
}

// Short-lived opaque challenge. Used for both the login second step
// (purpose=LOGIN) and the setup handshake (purpose=SETUP, which additionally
// carries the pending secret in secretEnc).
model TwoFactorChallenge {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique // sha256 of the raw challenge / setup token
  purpose    String    @default("LOGIN")
  secretEnc  String? // encrypted pending secret, only for purpose=SETUP
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("two_factor_challenges")
}
