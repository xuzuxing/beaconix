enum NotificationAccessScope {
  UNKNOWN
  ACCOUNT
  INVITATION
  ORGANIZATION
  PROJECT
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_COMMENTED
  TASK_STATUS_CHANGED
  TASK_DUE_SOON
  TASK_OVERDUE
  SPRINT_STARTED
  SPRINT_COMPLETED
  PROJECT_ARCHIVED
  MEMBER_JOINED
  MEMBER_REMOVED
  MENTION
  INVITATION_RECEIVED
  INVITATION_ACCEPTED
  INVITATION_DECLINED
  INVITATION_REVOKED
  INVITATION_EXPIRED
  MEMBER_ROLE_CHANGED
  MEMBER_LEFT
  OWNERSHIP_TRANSFERRED
  ORGANIZATION_DELETED
  ORGANIZATION_RESTORED
  TASK_UNASSIGNED
  TASK_DELETED
  TASK_RESTORED
  TASK_SPRINT_CHANGED
  TASK_DEPENDENCY_CHANGED
  TASK_UNBLOCKED
  COMMENT_REPLIED
  PROJECT_DELETED
  PROJECT_RESTORED
  SPRINT_DELETED
  PASSWORD_CHANGED
  PASSWORD_RESET_COMPLETED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  TWO_FACTOR_RECOVERY_CODE_USED
  TWO_FACTOR_RECOVERY_CODES_REGENERATED
  PAYMENT_SUCCEEDED
  PAYMENT_REFUNDED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  MONITOR_CAPACITY_GRACE_STARTED
  MONITOR_CAPACITY_GRACE_ENDING
  MONITOR_CAPACITY_LIMITED
  MONITOR_CAPACITY_RESTORED
  MONITOR_ALERT
  MONITOR_RECOVERED
  ALERT_DELIVERY_FAILED_SUMMARY
  API_KEY_CREATED
  API_KEY_REVOKED
  PERSONAL_ACCESS_TOKEN_CREATED
  PERSONAL_ACCESS_TOKEN_REVOKED
  PROBE_ENROLLED
  PROBE_SECRET_ROTATED
  PROBE_CREDENTIAL_REVOKED
  TICKET_CREATED
  TICKET_REPLIED
  TICKET_STATUS_CHANGED
  TICKET_ASSIGNED
}

// NOTIFICATION
model Notification {
  id           String           @id @default(cuid())
  userId       String
  organizationId String?
  projectId String?
  accessScope NotificationAccessScope @default(UNKNOWN)
  dedupKey     String?          @unique
  type         NotificationType
  title        String
  body         String?
  isRead       Boolean          @default(false)
  readAt       DateTime?
  // Generic resource pointer
  resourceType String? // e.g. "Task", "Comment", "Sprint"
  resourceId   String? // UUID of the related resource
  meta         Json?            @default("{}")

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, accessScope, projectId, isRead])
  @@index([createdAt])
  @@index([resourceType, resourceId])
  @@map("notifications")
}

// Transactional delivery intents; network delivery never runs in business transactions.
model NotificationDelivery {
  id          String    @id @default(cuid())
  dedupKey    String    @unique
  channel     String
  payload     Json
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  leaseUntil  DateTime?
  leaseToken  String?
  lastError   String?
  deliveredAt DateTime?
  dispatchAuthorizedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, availableAt])
  @@index([status, leaseUntil])
  @@map("notification_deliveries")
}
