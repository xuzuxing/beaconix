{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "moduleResolution": "Bundler",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "strict": true,
        "declaration": true,
        "outDir": "dist",
        "rootDir": ".",
        "skipLibCheck": true,
        "noEmitOnError": true
    },
    "include": ["rum-browser.ts", "src/**/*.ts"]
}
