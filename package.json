{
  "name": "beaconix",
  "version": "0.0.1",
  "author": "Xuzuxing",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:monitor:safety": "tsx --test test/monitor-postgres/safety.spec.ts",
    "test:monitor:postgres": "tsx --test --test-concurrency=1 test/monitor-postgres/monitor.integration-spec.ts",
    "test:monitor:applications": "tsx --test --test-concurrency=1 test/application-monitors/database.integration-spec.ts",
    "test:project-access:safety": "tsx --test test/project-access/safety.spec.ts test/project-access/harness.spec.ts test/project-access/http-fixture.spec.ts",
    "test:project-access:postgres": "tsx --test --test-concurrency=1 test/project-access/database.integration-spec.ts",
    "test:project-access:http": "tsx --test --test-concurrency=1 test/project-access/http.integration-spec.ts",
    "prepare": "husky",
    "prisma:studio": "npx prisma studio",
    "prisma:generate": "pnpm exec prisma generate",
    "prisma:migrate": "npx prisma migrate",
    "prisma:migrate:reset": "npx prisma migrate reset --force",
    "prisma:migrate:deploy": "npx prisma migrate deploy",
    "prisma:db:pull": "npx prisma db pull",
    "prisma:db:push": "npx prisma db push",
    "prisma:db:seed": "npx prisma db seed",
    "prisma:validate": "npx prisma validate",
    "admin:create": "tsx scripts/create-admin.ts",
    "test:resend": "ts-node scripts/test-resend.ts",
    "test:smtp": "tsx scripts/test-smtp.ts",
    "probe:cli": "node probes/agent/bin/beaconix-probe.js",
    "probe:login": "node probes/agent/bin/beaconix-probe.js login",
    "probe:run": "node probes/agent/bin/beaconix-probe.js run",
    "probe:validate": "node probes/agent/bin/beaconix-probe.js validate",
    "probe:status": "node probes/agent/bin/beaconix-probe.js status",
    "probe:stop": "node probes/agent/bin/beaconix-probe.js stop",
    "probe:scf": "node probes/agent/functions/scf.js",
    "probe:pack": "node probes/agent/scripts/build-release.js",
    "probe:pack:scf": "node probes/agent/scripts/build-release.js --scf-only",
    "probe:verify": "node probes/agent/scripts/verify-release.js",
    "probe:publish": "node probes/agent/scripts/publish-release.js",
    "probe:test": "node --test \"probes/agent/test/*.test.js\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@nestjs-cls/transactional": "^4.0.1",
    "@nestjs-cls/transactional-adapter-prisma": "^2.0.1",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prometheus-io/client": "^0.16.1",
    "@scalar/nestjs-api-reference": "^1.2.26",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.11",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dayjs": "^1.11.23",
    "hbs": "^4.3.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "mongodb": "^7.7.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "nestjs-cls": "^7.0.1",
    "nestjs-pino": "^5.3.1",
    "node-cache": "^5.1.2",
    "nodemailer": "^10.1.1",
    "otplib": "^13.5.0",
    "pg": "^8.22.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.17.1",
    "rxjs": "^7.8.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "prettier": "^3.9.4",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest",
      "^.+\\.js$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true,
            "module": "CommonJS",
            "moduleResolution": "Node",
            "esModuleInterop": true,
            "verbatimModuleSyntax": false
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!.*(@nestjs[\\\\/]bullmq|@nestjs[\\\\/]bull-shared|bullmq|otplib|@otplib[\\\\/]|@scure[\\\\/]|@noble[\\\\/]))"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
