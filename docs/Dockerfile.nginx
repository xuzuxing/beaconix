# Nginx reverse proxy for the Beacon API.
#
# The API container (./Dockerfile) listens on :3000 with the global `/api`
# prefix, serves public attachments under `/storage/public/...` and keeps a
# long-lived SSE stream at `/api/notifications/stream`. This proxy adds nothing
# to the app contract — it only fronts it with sane timeouts, body limits and a
# cache for public files.
#
# Build (context is docs/, nothing else is copied):
#   docker build -f docs/Dockerfile.nginx -t beaconix-nginx docs
#
# Use with the repo's docker-compose.yml by appending:
#   nginx:
#     build:
#       context: ./docs
#       dockerfile: Dockerfile.nginx
#     image: beaconix-nginx
#     container_name: beaconix-nginx
#     restart: unless-stopped
#     ports:
#       - "${NGINX_HTTP_PORT:-80}:80"
#     environment:
#       BEACON_API_UPSTREAM: app:3000      # compose service name:port
#       BEACON_SERVER_NAME: _              # or api.example.com
#     depends_on:
#       app:
#         condition: service_started
#
# Nothing here terminates TLS. Either keep that on the cloud load balancer, or
# mount certificates and uncomment the 443 server block at the end of the
# template below.
#
# Note: nginx resolves the upstream host name at start up, so the API container
# must already exist on the same Docker network (compose `depends_on` covers
# this). `restart: unless-stopped` lets the proxy come back once it does.
FROM nginx:1.28-alpine

# Upstream to proxy to, as `host:port`. Override at run time.
ENV BEACON_API_UPSTREAM=app:3000 \
    BEACON_SERVER_NAME=_ \
    # Only substitute BEACON_* variables, so nginx's own $host / $http_upgrade
    # etc. survive envsubst untouched (env_file values such as HOST=localhost
    # would otherwise blank them out).
    NGINX_ENVSUBST_FILTER=^BEACON_ \
    NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx/conf.d

# The image's entrypoint runs envsubst over /etc/nginx/templates/*.template and
# writes the result into NGINX_ENVSUBST_OUTPUT_DIR before nginx starts.
RUN mkdir -p /etc/nginx/templates /var/cache/nginx/beacon

RUN cat > /etc/nginx/templates/default.conf.template <<'EOF'
# --- Connection upgrade (WebSocket-style) support -------------------------
# The app talks SSE today, but keeping this map lets any future WS endpoint
# work behind the same proxy.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

# --- Cache for public attachments ----------------------------------------
# `/storage/public/...` files are content-addressed by year/month and never
# rewritten in place, so they cache well.
proxy_cache_path /var/cache/nginx/beacon
                 levels=1:2
                 keys_zone=beacon_public:16m
                 inactive=7d
                 max_size=1g
                 use_temp_path=off;

# --- Optional per-IP rate limiting ---------------------------------------
# The app already throttles (ThrottlerGuard), so this is off by default; it
# protects the proxy itself against floods that never reach the app.
# Uncomment both lines (here and inside `location /api/`) to enable.
# limit_req_zone $binary_remote_addr zone=beacon_api:10m rate=20r/s;

log_format beacon '$remote_addr - $remote_user [$time_local] "$request" '
                  '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
                  'rt=$request_time urt=$upstream_response_time';

upstream beacon_api {
    server ${BEACON_API_UPSTREAM} max_fails=3 fail_timeout=10s;
    # Long-lived SSE connections need keepalive + HTTP/1.1 to the upstream.
    keepalive 32;
}

server {
    listen 80;
    server_name ${BEACON_SERVER_NAME};

    server_tokens off;
    access_log /var/log/nginx/access.log beacon;

    # Attachment uploads are capped at 32 MB by the app (multer `fileSize`);
    # leave headroom for the multipart envelope.
    client_max_body_size 40m;
    client_body_timeout 60s;
    keepalive_timeout 65s;

    gzip on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    # Deliberately no text/event-stream: gzip buffers and would stall SSE.
    gzip_types application/json application/javascript text/css text/plain
               text/xml application/xml image/svg+xml;

    # Proxy-local health check; does not touch the app.
    location = /nginx-health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok\n';
    }

    # SSE notification stream: no buffering, no gzip, no idle timeout.
    # `Connection ''` keeps the upstream connection in keepalive mode.
    location ^~ /api/notifications/stream {
        proxy_pass http://beacon_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection '';

        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;

        # Belt and braces: tells the app not to buffer either.
        add_header X-Accel-Buffering no;
    }

    # Public attachments (avatars, brand images, uploads). The app already
    # sends Access-Control-Allow-Origin: * for these; the cache must not drop it.
    location ^~ /storage/public/ {
        proxy_pass http://beacon_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';

        proxy_cache beacon_public;
        proxy_cache_valid 200 302 7d;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_cache_lock on;
        # Never cache or forward upstream cookies for static files.
        proxy_ignore_headers Set-Cookie Cache-Control;
        proxy_hide_header Set-Cookie;
        add_header X-Cache-Status $upstream_cache_status;

        expires 1d;
    }

    # The whole API, including WeChat/Alipay async callbacks. Bodies are
    # forwarded byte-for-byte; the app verifies signatures against rawBody.
    location /api/ {
        # limit_req zone=beacon_api burst=40 nodelay;

        proxy_pass http://beacon_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        proxy_buffering on;
        proxy_buffers 16 16k;
        proxy_busy_buffers_size 32k;

        # Swagger UI (/api/docs) and JSON responses are small; do not cache.
        proxy_cache off;
    }

    # Everything else is not part of the API surface.
    location / {
        return 404;
    }

    # --- TLS ---------------------------------------------------------------
    # Uncomment once certificates are mounted at /etc/nginx/certs, and add
    # `listen 443 ssl;` to a copy of this server block (or replace the 80
    # listener above), plus a plain-80 block that redirects to https.
    #
    # listen 443 ssl;
    # http2 on;
    # ssl_certificate     /etc/nginx/certs/fullchain.pem;
    # ssl_certificate_key /etc/nginx/certs/privkey.pem;
    # ssl_protocols TLSv1.2 TLSv1.3;
    # ssl_session_cache shared:SSL:10m;
    # ssl_session_timeout 1d;
    # add_header Strict-Transport-Security "max-age=31536000" always;
    #
    # Real client IPs behind a CDN/LB: trust that hop and rewrite $remote_addr.
    # set_real_ip_from 10.0.0.0/8;
    # real_ip_header X-Forwarded-For;
    # real_ip_recursive on;
}
EOF

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1/nginx-health >/dev/null || exit 1

# Default CMD/entrypoint from the base image: envsubst the template, then run
# nginx in the foreground.
